@using ImportCostPro.Data.Contexts
@inject ImportCostDbContext _context
@{
    ViewData["Title"] = "Dashboard";

    var totalPaises = _context.Paises.Count();
    var totalMonedas = _context.Monedas.Count();
    var totalProveedores = _context.Proveedores.Count();
    var totalImportadores = _context.Importadores.Count();
    var totalProductos = _context.Productos.Count();
    var totalCategorias = _context.CategoriasArancelarias.Count();
}

<!-- ── Encabezado ──────────────────────────────────────────── -->
<div class="icp-page-header">
    <div class="icp-page-header-left">
        <div class="icp-page-icon" style="background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.2);">
            <i class="bi bi-grid-1x2-fill" style="color: var(--accent-blue);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Dashboard</h1>
            <p class="icp-page-subtitle">Resumen ejecutivo del sistema logístico de importaciones</p>
        </div>
    </div>
    <a asp-controller="CalculoLandedCost" asp-action="Index" class="btn-icp-primary">
        <i class="bi bi-calculator-fill"></i> Calcular Landed Cost
    </a>
</div>

<!-- ── KPI Metrics ─────────────────────────────────────────── -->
<div class="row g-3 mb-4">

    <div class="col-sm-6 col-lg-4">
        <a asp-controller="Pais" asp-action="Index" class="text-decoration-none d-block">
            <div class="icp-metric-card" style="--metric-accent: var(--accent-cyan);">
                <div class="icp-metric-header">
                    <span class="icp-metric-label">Países Registrados</span>
                    <div class="icp-metric-icon" style="background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.2);">
                        <i class="bi bi-globe-americas" style="color: var(--accent-cyan);"></i>
                    </div>
                </div>
                <div class="icp-metric-value counter" data-target="@totalPaises" style="color: var(--accent-cyan);">0</div>
                <div class="icp-metric-desc">Orígenes geográficos activos</div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-4">
        <a asp-controller="Moneda" asp-action="Index" class="text-decoration-none d-block">
            <div class="icp-metric-card" style="--metric-accent: var(--accent-orange);">
                <div class="icp-metric-header">
                    <span class="icp-metric-label">Monedas</span>
                    <div class="icp-metric-icon" style="background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.2);">
                        <i class="bi bi-currency-exchange" style="color: var(--accent-orange);"></i>
                    </div>
                </div>
                <div class="icp-metric-value counter" data-target="@totalMonedas" style="color: var(--accent-orange);">0</div>
                <div class="icp-metric-desc">Divisas disponibles en el sistema</div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-4">
        <a asp-controller="Proveedor" asp-action="Index" class="text-decoration-none d-block">
            <div class="icp-metric-card" style="--metric-accent: var(--accent-purple);">
                <div class="icp-metric-header">
                    <span class="icp-metric-label">Proveedores</span>
                    <div class="icp-metric-icon" style="background: rgba(139,92,246,0.12); border: 1px solid rgba(139,92,246,0.2);">
                        <i class="bi bi-truck" style="color: var(--accent-purple);"></i>
                    </div>
                </div>
                <div class="icp-metric-value counter" data-target="@totalProveedores" style="color: var(--accent-purple);">0</div>
                <div class="icp-metric-desc">Suplidores internacionales</div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-4">
        <a asp-controller="Importador" asp-action="Index" class="text-decoration-none d-block">
            <div class="icp-metric-card" style="--metric-accent: var(--accent-green);">
                <div class="icp-metric-header">
                    <span class="icp-metric-label">Importadores</span>
                    <div class="icp-metric-icon" style="background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.2);">
                        <i class="bi bi-person-badge" style="color: var(--accent-green);"></i>
                    </div>
                </div>
                <div class="icp-metric-value counter" data-target="@totalImportadores" style="color: var(--accent-green);">0</div>
                <div class="icp-metric-desc">Empresas importadoras locales</div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-4">
        <a asp-controller="Productos" asp-action="Index" class="text-decoration-none d-block">
            <div class="icp-metric-card" style="--metric-accent: var(--accent-red);">
                <div class="icp-metric-header">
                    <span class="icp-metric-label">Productos</span>
                    <div class="icp-metric-icon" style="background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.2);">
                        <i class="bi bi-tags" style="color: var(--accent-red);"></i>
                    </div>
                </div>
                <div class="icp-metric-value counter" data-target="@totalProductos" style="color: var(--accent-red);">0</div>
                <div class="icp-metric-desc">Artículos en catálogo</div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-4">
        <a asp-controller="CategoriasArancelarias" asp-action="Index" class="text-decoration-none d-block">
            <div class="icp-metric-card" style="--metric-accent: var(--accent-blue);">
                <div class="icp-metric-header">
                    <span class="icp-metric-label">Categorías Arancelarias</span>
                    <div class="icp-metric-icon" style="background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.2);">
                        <i class="bi bi-percent" style="color: var(--accent-blue);"></i>
                    </div>
                </div>
                <div class="icp-metric-value counter" data-target="@totalCategorias" style="color: var(--accent-blue);">0</div>
                <div class="icp-metric-desc">Grupos tributarios configurados</div>
            </div>
        </a>
    </div>

</div>
<!-- ── Accesos Rápidos ─────────────────────────────────────── -->
<div class="icp-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <span class="icp-form-section-label mb-0">Accesos Rápidos</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="TasaCambio" asp-action="Index" class="icp-quick-link">
            <i class="bi bi-arrow-left-right"></i> Tasas de Cambio
        </a>
        <a asp-controller="ConfiguracionImpuesto" asp-action="Index" class="icp-quick-link">
            <i class="bi bi-sliders"></i> Config. Impuestos
        </a>
        <a asp-controller="CalculoLandedCost" asp-action="Index" class="icp-quick-link">
            <i class="bi bi-calculator"></i> Cálculo Landed Cost
        </a>
        <a asp-controller="CategoriasArancelarias" asp-action="Create" class="icp-quick-link">
            <i class="bi bi-plus-circle"></i> Nueva Categoría
        </a>
        <a asp-controller="Proveedor" asp-action="Create" class="icp-quick-link">
            <i class="bi bi-plus-circle"></i> Nuevo Proveedor
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const counters = document.querySelectorAll('.counter');

            const speed = 50;

            counters.forEach(counter => {
                const updateCount = () => {
                    const target = +counter.getAttribute('data-target');
                    const count = +counter.innerText;

                    const inc = target / speed;

                    if (count < target) {
                        counter.innerText = Math.ceil(count + inc);
                        setTimeout(updateCount, 20);
                    } else {
                        counter.innerText = target;
                    }
                };

                updateCount();
            });
        });
    </script>
}