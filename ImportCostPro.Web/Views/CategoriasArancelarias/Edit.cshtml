@model ImportCostPro.Core.ViewModels.CategoriaArancelariaViewModel

@{
    ViewData["Title"] = "Editar categoría arancelaria";
    bool bloqueado = Model.TieneProductosAsociados;
}

<div class="container">
    <h2 class="mb-4">Editar categoría arancelaria</h2>

    @if (bloqueado)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            Esta categoría tiene productos asociados. Solo se puede
            modificar el nombre y el estado.
        </div>
    }

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="TieneProductosAsociados" type="hidden" />

        <div asp-validation-summary="All"
             class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="CodigoArancelario" class="form-label"></label>
                <input asp-for="CodigoArancelario" class="form-control"
                       disabled="@bloqueado" />
                @if (bloqueado)
                {
                    <input type="hidden" asp-for="CodigoArancelario" />
                }
                <span asp-validation-for="CodigoArancelario"
                      class="text-danger small"></span>
            </div>

            <div class="col-md-8 mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre"
                      class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="PorcentajeArancel" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="PorcentajeArancel"
                           class="form-control"
                           disabled="@bloqueado" />
                    <span class="input-group-text">%</span>
                </div>
                @if (bloqueado)
                {
                    <input type="hidden" asp-for="PorcentajeArancel" />
                }
                <span asp-validation-for="PorcentajeArancel"
                      class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <div class="form-check form-switch mt-4">
                    <input asp-for="AplicaItbis"
                           class="form-check-input" type="checkbox"
                           disabled="@bloqueado" />
                    <label asp-for="AplicaItbis"
                           class="form-check-label"></label>
                </div>
                @if (bloqueado)
                {
                    <input type="hidden" asp-for="AplicaItbis" />
                }
            </div>

            <div class="col-md-4 mb-3">
                <div class="form-check form-switch mt-4">
                    <input asp-for="AplicaImpuestoSelectivo"
                           class="form-check-input" type="checkbox"
                           id="chkSelectivo"
                           disabled="@bloqueado"
                           onchange="toggleSelectivo(this)" />
                    <label asp-for="AplicaImpuestoSelectivo"
                           class="form-check-label"></label>
                </div>
                @if (bloqueado)
                {
                    <input type="hidden" asp-for="AplicaImpuestoSelectivo" />
                }
            </div>

            <div class="col-md-4 mb-3" id="divSelectivo">
                <label asp-for="PorcentajeImpuestoSelectivo"
                       class="form-label"></label>
                <div class="input-group">
                    <input asp-for="PorcentajeImpuestoSelectivo"
                           class="form-control"
                           disabled="@bloqueado" />
                    <span class="input-group-text">%</span>
                </div>
                @if (bloqueado)
                {
                    <input type="hidden"
                           asp-for="PorcentajeImpuestoSelectivo" />
                }
                <span asp-validation-for="PorcentajeImpuestoSelectivo"
                      class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-check form-switch">
                <input asp-for="Activo" class="form-check-input"
                       type="checkbox" />
                <label asp-for="Activo" class="form-check-label"></label>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-floppy"></i> Guardar cambios
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver atrás
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function toggleSelectivo(checkbox) {
            const div = document.getElementById('divSelectivo');
            div.style.display = checkbox.checked ? 'block' : 'none';
        }

        window.onload = function () {
            const chk = document.getElementById('chkSelectivo');
            if (chk) {
                document.getElementById('divSelectivo').style.display =
                    chk.checked ? 'block' : 'none';
            }
        }
    </script>
}
