@model ImportCostPro.Core.ViewModels.CategoriaArancelaria.CategoriaArancelariaViewModel

@{
    ViewData["Title"] = "Editar Categoría Arancelaria";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-2">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <div class="icp-page-icon" style="background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.2);">
            <i class="bi bi-pencil-square" style="color: var(--accent-cyan);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Editar Categoría Arancelaria</h1>
            <p class="icp-page-subtitle">Actualiza las tasas impositivas. Los cambios afectarán los próximos cálculos de Landed Cost</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="icp-card">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="TieneProductosAsociados" />

                @if (Model.TieneProductosAsociados)
                {
                    <div class="icp-alert-warning mb-4">
                        <i class="bi bi-lock-fill me-2"></i>
                        <strong>Atención:</strong> Esta categoría ya está siendo utilizada por uno o más productos. Los porcentajes de impuestos están bloqueados para no afectar la integridad de cálculos anteriores.
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="CodigoArancelario" class="icp-field-label"></label>
                    <input asp-for="CodigoArancelario" class="form-control font-monospace" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="icp-field-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger fs-xs"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="PorcentajeArancel" class="icp-field-label"></label>
                    <div class="input-group">
                        <input asp-for="PorcentajeArancel" class="form-control text-end fs-5 fw-bold"
                                type="number" step="0.01" readonly="@(Model.TieneProductosAsociados ? "readonly" : null)" />
                        <span class="input-group-text fw-bold">%</span>
                    </div>
                    <span asp-validation-for="PorcentajeArancel" class="text-danger fs-xs"></span>
                </div>

                <div class="icp-toggle-panel mb-4">
                    <span class="icp-form-section-label"><i class="bi bi-calculator me-2 text-accent-cyan"></i>Configuración de Gravámenes</span>

                    <div class="icp-toggle-row">
                        <div>
                            <label asp-for="AplicaItbis" class="fw-600 fs-sm" style="color:var(--text-primary);"></label>
                        </div>
                        <input asp-for="AplicaItbis" class="form-check-input ms-3 fs-5" type="checkbox" role="switch" disabled="@(Model.TieneProductosAsociados ? "disabled" : null)" />
                        @if (Model.TieneProductosAsociados) { <input type="hidden" asp-for="AplicaItbis" /> }
                    </div>

                    <div class="icp-toggle-row">
                        <div>
                            <label asp-for="AplicaImpuestoSelectivo" class="fw-600 fs-sm" style="color:var(--text-primary);"></label>
                        </div>
                        <input asp-for="AplicaImpuestoSelectivo" class="form-check-input ms-3 fs-5" type="checkbox" role="switch" id="switchIsc" disabled="@(Model.TieneProductosAsociados ? "disabled" : null)" />
                        @if (Model.TieneProductosAsociados) { <input type="hidden" asp-for="AplicaImpuestoSelectivo" /> }
                    </div>

                    <div class="mt-3" id="boxIsc">
                        <label asp-for="PorcentajeImpuestoSelectivo" class="icp-field-label"></label>
                        <div class="input-group input-group-sm">
                            <input asp-for="PorcentajeImpuestoSelectivo" class="form-control text-end fw-bold"
                                    type="number" step="0.01" readonly="@(Model.TieneProductosAsociados ? "readonly" : null)" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>

                <div class="icp-toggle-panel mb-5">
                    <div class="icp-toggle-row">
                        <label asp-for="Activo" class="fw-600 fs-sm" style="color:var(--text-primary);"></label>
                        <input asp-for="Activo" class="form-check-input ms-3 fs-5" type="checkbox" role="switch" />
                    </div>
                </div>

                <div class="icp-form-footer">
                    <a asp-action="Index" class="btn-cancel">Cancelar</a>
                    <button type="submit" class="btn-save btn-save-cyan">
                        <i class="bi bi-check-lg me-1"></i> Aplicar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const switchIsc = document.getElementById('switchIsc');
        const boxIsc = document.getElementById('boxIsc');
        const inputIsc = document.getElementById('PorcentajeImpuestoSelectivo');
        const form = document.querySelector('form');

        function toggleIsc() {
            if (switchIsc.checked) {
                boxIsc.style.display = 'block';
            } else {
                boxIsc.style.display = 'none';
                if (!inputIsc.readOnly) {
                    inputIsc.value = '0.00';
                }
            }
        }

        switchIsc.addEventListener('change', toggleIsc);
        toggleIsc();

        form.addEventListener('submit', function(e) {
            if (switchIsc.checked) {
                const val = parseFloat(inputIsc.value);
                if (isNaN(val) || val <= 0) {
                    e.preventDefault();
                    alert('Debe ingresar un porcentaje de Impuesto Selectivo mayor a 0 si aplica dicho impuesto.');
                    inputIsc.focus();
                }
            }
        });
    });
</script>
}