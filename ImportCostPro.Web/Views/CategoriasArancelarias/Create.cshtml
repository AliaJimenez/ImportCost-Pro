@model ImportCostPro.Core.ViewModels.CategoriaArancelariaViewModel

@{
    ViewData["Title"] = "Crear Categoría Arancelaria";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-1">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <div class="icp-page-icon" style="background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.2);">
            <i class="bi bi-percent" style="color: var(--accent-blue);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Nueva Categoría Arancelaria</h1>
            <p class="icp-page-subtitle">Define la partida arancelaria y las reglas impositivas</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="icp-card">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="icp-alert-danger mb-4"></div>

                <div class="mb-3">
                    <label asp-for="CodigoArancelario" class="icp-field-label"></label>
                    <input asp-for="CodigoArancelario" class="form-control font-monospace"
                           placeholder="Ej: 8528.59.00" />
                    <span asp-validation-for="CodigoArancelario" class="text-danger fs-xs"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="icp-field-label"></label>
                    <input asp-for="Nombre" class="form-control"
                           placeholder="Ej: Monitores con tecnología LCD o LED" />
                    <span asp-validation-for="Nombre" class="text-danger fs-xs"></span>
                </div>


                <div class="mb-4">
                    <label asp-for="PorcentajeArancel" class="icp-field-label"></label>
                    <div class="input-group">
                        <input asp-for="PorcentajeArancel" class="form-control text-end fs-5 fw-bold"
                               placeholder="0.00" type="number" step="0.01" />
                        <span class="input-group-text fw-bold">%</span>
                    </div>
                    <span asp-validation-for="PorcentajeArancel" class="text-danger fs-xs"></span>
                </div>

                <div class="icp-toggle-panel mb-4">
                    <span class="icp-form-section-label"><i class="bi bi-calculator me-2 text-accent-cyan"></i>Configuración de Gravámenes</span>

                    <div class="icp-toggle-row">
                        <div>
                            <label asp-for="AplicaItbis" class="fw-600 fs-sm" style="color:var(--text-primary);cursor:pointer;"></label>
                            <small class="d-block mt-1" style="color:var(--text-muted);">Indica si la partida está gravada con el impuesto al valor agregado.</small>
                        </div>
                        <input asp-for="AplicaItbis" class="form-check-input ms-3 fs-5" type="checkbox" role="switch" checked />
                    </div>

                    <div class="icp-toggle-row">
                        <div>
                            <label asp-for="AplicaImpuestoSelectivo" class="fw-600 fs-sm" style="color:var(--text-primary);cursor:pointer;"></label>
                            <small class="d-block mt-1" style="color:var(--text-muted);">Aplica para bienes de consumo específico o suntuarios.</small>
                        </div>
                        <input asp-for="AplicaImpuestoSelectivo" class="form-check-input ms-3 fs-5" type="checkbox" role="switch" id="switchIsc" />
                    </div>

                    <div class="mt-3" id="boxIsc">
                        <label asp-for="PorcentajeImpuestoSelectivo" class="icp-field-label"></label>
                        <div class="input-group input-group-sm">
                            <input asp-for="PorcentajeImpuestoSelectivo" class="form-control text-end fw-bold"
                                   type="number" step="0.01" value="0.00" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="PorcentajeImpuestoSelectivo" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <div class="icp-toggle-panel mb-5">
                    <div class="icp-toggle-row">
                        <div>
                            <label asp-for="Activo" class="fw-600 fs-sm" style="color:var(--text-primary);cursor:pointer;"></label>
                            <small class="d-block mt-1" style="color:var(--text-muted);">Si se apaga, no se podrá asignar esta partida a nuevos productos.</small>
                        </div>
                        <input asp-for="Activo" class="form-check-input ms-3 fs-5" type="checkbox" role="switch" />
                    </div>
                </div>

                <div class="icp-form-footer">
                    <a asp-action="Index" class="btn-cancel">Cancelar</a>
                    <button type="submit" class="btn-save">
                        <i class="bi bi-check-lg me-1"></i> Guardar Categoría
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}