@model IEnumerable<ImportCostPro.Core.Dtos.CategoriaArancelariaDto>

@{
    ViewData["Title"] = "Categorías Arancelarias";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <div class="icp-page-icon" style="background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.2);">
            <i class="bi bi-percent" style="color: var(--accent-blue);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Categorías Arancelarias</h1>
            <p class="icp-page-subtitle">Configure los porcentajes de arancel e ITBIS por categoría de producto</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-icp-primary">
        <i class="bi bi-plus-lg"></i> Nueva Categoría
    </a>
</div>

<div class="icp-toolbar">
    <div class="icp-toolbar-left">
        <div class="icp-search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchCat" placeholder="Buscar categoría..." />
        </div>
    </div>
    <div class="icp-toolbar-right">
        <span class="icp-count-label" id="countCat">@Model.Count() categorías configuradas</span>
    </div>
</div>

<div class="icp-table-wrapper">
    <table class="icp-table">
        <thead>
            <tr>
                <th style="width:35%;">Categoría</th>
                <th style="width:10%;" class="text-center">Arancel (%)</th>
                <th style="width:10%;" class="text-center">ITBIS (%)</th>
                <th style="width:15%;" class="text-center">Carga Total Est.</th>
                <th style="width:30%;" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-5" style="color: var(--text-muted);">
                        <i class="bi bi-percent display-5 d-block mb-3" style="opacity: .25;"></i>
                        No hay categorías arancelarias registradas.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    var itbisVal = item.AplicaItbis
                        ? (item.PorcentajeImpuestoSelectivo > 0 ? item.PorcentajeImpuestoSelectivo : 18m)
                        : 0m;
                    var cargaTotal = item.PorcentajeArancel + itbisVal;

                    <tr class="cat-row">
                        <td class="fw-600" style="color: var(--text-primary);">
                            <i class="bi bi-tag-fill me-2" style="color: var(--accent-blue); font-size: 0.72rem;"></i>
                            @item.Nombre
                        </td>
                        <td class="text-center">
                            <span class="icp-rate-orange">@item.PorcentajeArancel%</span>
                        </td>
                        <td class="text-center">
                            @if (item.AplicaItbis)
                            {
                                <span class="icp-rate-green">
                                    @(item.PorcentajeImpuestoSelectivo > 0 ? item.PorcentajeImpuestoSelectivo + "%" : "18%")
                                </span>
                            }
                            else
                            {
                                <span class="icp-rate-muted">0%</span>
                            }
                        </td>
                        <td class="text-center" style="color: var(--text-secondary); font-weight: 600;">~@cargaTotal%</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icp-edit">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icp-delete">
                                    <i class="bi bi-trash3"></i> Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    document.getElementById('searchCat')?.addEventListener('input', function () {
        var q = this.value.toLowerCase(); var vis = 0;
        document.querySelectorAll('.cat-row').forEach(function (r) {
            var show = r.textContent.toLowerCase().includes(q);
            r.style.display = show ? '' : 'none';
            if (show) vis++;
        });
        document.getElementById('countCat').textContent = vis + ' categorías configuradas';
    });
</script>
}