@model ImportCostPro.Core.ViewModels.ProductoViewModel

@{
    ViewData["Title"] = "Editar producto";
}

<div class="container">
    <h2 class="mb-4">Editar producto</h2>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="TieneOrdenesAsociadas" type="hidden" />

        <div asp-validation-summary="All"
             class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-8 mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre"
                      class="text-danger small"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="CodigoReferencia" class="form-label"></label>
                <input asp-for="CodigoReferencia" class="form-control" />
                <span asp-validation-for="CodigoReferencia"
                      class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CategoriaArancelariaId"
                       class="form-label"></label>
                <select asp-for="CategoriaArancelariaId"
                        asp-items="Model.CategoriasDisponibles"
                        class="form-select">
                    <option value="">-- Seleccione una categoría --</option>
                </select>
                <span asp-validation-for="CategoriaArancelariaId"
                      class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="PaisOrigenId" class="form-label"></label>
                <select asp-for="PaisOrigenId"
                        class="form-select" disabled>
                    <option value="">-- Disponible pronto --</option>
                </select>
                <input type="hidden" asp-for="PaisOrigenId" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="PesoUnitario" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="PesoUnitario" class="form-control" />
                    <span class="input-group-text">kg</span>
                </div>
                <span asp-validation-for="PesoUnitario"
                      class="text-danger small"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="UnidadMedida" class="form-label"></label>
                <select asp-for="UnidadMedida"
                        asp-items="Model.UnidadesMedidaDisponibles"
                        class="form-select">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="UnidadMedida"
                      class="text-danger small"></span>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                Dimensiones <small class="text-muted">
                (opcional — si ingresa una debe ingresar las tres)
            </small>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Largo" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Largo" class="form-control" />
                        <span class="input-group-text">cm</span>
                    </div>
                    <span asp-validation-for="Largo"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Ancho" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Ancho" class="form-control" />
                        <span class="input-group-text">cm</span>
                    </div>
                    <span asp-validation-for="Ancho"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Alto" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Alto" class="form-control" />
                        <span class="input-group-text">cm</span>
                    </div>
                    <span asp-validation-for="Alto"
                          class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control"
                  rows="3"></textarea>
        <span asp-validation-for="Descripcion"
              class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <div class="form-check form-switch">
            <input asp-for="Activo" class="form-check-input"
                   type="checkbox" />
            <label asp-for="Activo" class="form-check-label"></label>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-floppy"></i> Guardar cambios
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver atrás
        </a>
    </div>
</form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}