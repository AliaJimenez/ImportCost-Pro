@model ImportCostPro.Core.ViewModels.Producto.ProductoViewModel

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-2">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <div class="icp-page-icon" style="background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.2);">
            <i class="bi bi-tags" style="color: var(--accent-red);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Crear Producto</h1>
            <p class="icp-page-subtitle">Agrega un nuevo artículo al catálogo</p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-10">
        <div class="icp-card">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <span class="icp-form-section-label">Identificación</span>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Nombre" class="icp-field-label"></label>
                        <input asp-for="Nombre" class="form-control"
                               placeholder="Ej: Laptop Dell Latitude 5420" />
                        <span asp-validation-for="Nombre" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CodigoReferencia" class="icp-field-label"></label>
                        <input asp-for="CodigoReferencia" class="form-control"
                               placeholder="Ej: LAP-DELL-5420" />
                        <span asp-validation-for="CodigoReferencia" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CategoriaArancelariaId" class="icp-field-label"></label>
                        <select asp-for="CategoriaArancelariaId"
                                asp-items="Model.CategoriasDisponibles"
                                class="form-select">
                            <option value="">-- Seleccione una categoría --</option>
                        </select>
                        <span asp-validation-for="CategoriaArancelariaId" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PaisOrigenId" class="icp-field-label"></label>
                        <select asp-for="PaisOrigenId" class="form-select" disabled>
                            <option value="">-- Disponible pronto --</option>
                        </select>
                        <span asp-validation-for="PaisOrigenId" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <span class="icp-form-section-label">Medidas</span>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="PesoUnitario" class="icp-field-label"></label>
                        <div class="input-group">
                            <input asp-for="PesoUnitario" class="form-control" placeholder="0.00" />
                            <span class="input-group-text">kg</span>
                        </div>
                        <span asp-validation-for="PesoUnitario" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="UnidadMedida" class="icp-field-label"></label>
                        <select asp-for="UnidadMedida"
                                asp-items="Model.UnidadesMedidaDisponibles"
                                class="form-select">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="UnidadMedida" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <div class="icp-toggle-panel mb-4">
                    <span class="icp-form-section-label">
                        Dimensiones
                        <small style="color:var(--text-muted);font-size:0.72rem;">(opcional — si ingresa una debe ingresar las tres)</small>
                    </span>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Largo" class="icp-field-label"></label>
                            <div class="input-group">
                                <input asp-for="Largo" class="form-control" placeholder="0.00" />
                                <span class="input-group-text">cm</span>
                            </div>
                            <span asp-validation-for="Largo" class="text-danger fs-xs"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Ancho" class="icp-field-label"></label>
                            <div class="input-group">
                                <input asp-for="Ancho" class="form-control" placeholder="0.00" />
                                <span class="input-group-text">cm</span>
                            </div>
                            <span asp-validation-for="Ancho" class="text-danger fs-xs"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Alto" class="icp-field-label"></label>
                            <div class="input-group">
                                <input asp-for="Alto" class="form-control" placeholder="0.00" />
                                <span class="input-group-text">cm</span>
                            </div>
                            <span asp-validation-for="Alto" class="text-danger fs-xs"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Descripcion" class="icp-field-label"></label>
                    <textarea asp-for="Descripcion" class="form-control"
                              rows="3" placeholder="Descripción opcional..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger fs-xs"></span>
                </div>

                <div class="icp-toggle-panel mb-4">
                    <div class="icp-toggle-row">
                        <label asp-for="Activo" class="fw-600 fs-sm" style="color:var(--text-primary);"></label>
                        <input asp-for="Activo" class="form-check-input ms-3 fs-5" type="checkbox" checked />
                    </div>
                </div>

                <div class="icp-form-footer">
                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn-save">
                        <i class="bi bi-check-lg me-1"></i> Crear Producto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
<script>
    document.querySelector('form').addEventListener('submit', function(e) {
        const largo = document.getElementById('Largo').value;
        const ancho = document.getElementById('Ancho').value;
        const alto = document.getElementById('Alto').value;
        
        const isAnyFilled = largo || ancho || alto;
        
        if (isAnyFilled) {
            const lVal = parseFloat(largo);
            const wVal = parseFloat(ancho);
            const hVal = parseFloat(alto);
            
            if (isNaN(lVal) || lVal <= 0 || isNaN(wVal) || wVal <= 0 || isNaN(hVal) || hVal <= 0) {
                e.preventDefault();
                alert('Si ingresa una dimensión (Largo, Ancho, Alto), debe ingresar las tres y todas deben ser mayores a 0.');
            }
        }
    });
</script>
}