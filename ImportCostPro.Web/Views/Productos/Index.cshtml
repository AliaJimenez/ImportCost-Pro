@model List<ImportCostPro.Core.Dtos.ProductoDto>

@{
    ViewData["Title"] = "Productos";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <div class="icp-page-icon" style="background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.2);">
            <i class="bi bi-tags" style="color: var(--accent-red);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Productos</h1>
            <p class="icp-page-subtitle">Catálogo de artículos importables registrados</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-icp-primary">
        <i class="bi bi-plus-lg"></i> Crear Producto
    </a>
</div>

<div class="icp-toolbar">
    <div class="icp-toolbar-left">
        <div class="icp-search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchProd" placeholder="Buscar producto..." />
        </div>
    </div>
    <div class="icp-toolbar-right">
        <span class="icp-count-label" id="countProd">@Model.Count() registros</span>
    </div>
</div>

<div class="icp-table-wrapper">
    <table class="icp-table">
        <thead>
            <tr>
                <th style="width:12%;">Código</th>
                <th style="width:26%;">Nombre</th>
                <th style="width:24%;">Categoría Arancelaria</th>
                <th style="width:10%;" class="text-center">Peso (kg)</th>
                <th style="width:8%;" class="text-center">Unidad</th>
                <th style="width:8%;" class="text-center">Estado</th>
                <th style="width:12%;" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center py-5" style="color:var(--text-muted);">
                        <i class="bi bi-tags display-5 d-block mb-3" style="opacity:.3;"></i>
                        No hay productos registrados en el catálogo.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr class="prod-row">
                        <td><span class="icp-code-badge">@item.CodigoReferencia</span></td>
                        <td class="fw-600" style="color:var(--text-primary);">@item.Nombre</td>
                        <td style="color:var(--text-secondary);">@item.NombreCategoria</td>
                        <td class="text-center" style="color:var(--text-secondary);">@item.PesoUnitario</td>
                        <td class="text-center"><span class="icp-code-badge">@item.UnidadMedida</span></td>
                        <td class="text-center">
                            @if (item.Activo)
                            {
                                <span class="icp-badge icp-badge-success">Activo</span>
                            }
                            else
                            {
                                <span class="icp-badge icp-badge-danger">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icp-edit">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icp-delete">
                                    <i class="bi bi-trash3"></i> Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    document.getElementById('searchProd')?.addEventListener('input', function () {
        var q = this.value.toLowerCase(); var vis = 0;
        document.querySelectorAll('.prod-row').forEach(function (r) {
            var show = r.textContent.toLowerCase().includes(q);
            r.style.display = show ? '' : 'none';
            if (show) vis++;
        });
        document.getElementById('countProd').textContent = vis + ' registros';
    });
</script>
}
