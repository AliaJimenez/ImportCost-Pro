@model ImportCostPro.Core.ViewModels.ConfiguracionImpuestoViewModel

@{
    ViewData["Title"] = "Configuración de Impuestos";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <div class="icp-page-icon" style="background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.2);">
            <i class="bi bi-percent" style="color: var(--accent-orange);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Configuración de Impuestos</h1>
            <p class="icp-page-subtitle">Define las tasas de arancel e ITBIS por categoría arancelaria</p>
        </div>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="icp-alert-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
    </div>
}

<div class="icp-alert-warning mb-4">
    <i class="bi bi-info-circle me-2"></i>
    Las tasas configuradas aquí se aplican automáticamente al calcular el landed cost de los productos clasificados en cada categoría.
    El <strong>ITBIS</strong> se calcula sobre la base <em>CIF + Arancel</em>. Una tasa de <strong>0%</strong> indica exención del impuesto.
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="icp-card">
            <span class="icp-form-section-label">Parámetros Fiscales Globales</span>

            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="icp-alert-danger mb-4"></div>

                <div class="mb-4">
                    <label asp-for="PorcentajeITBIS" class="icp-field-label"></label>
                    <div class="input-group">
                        <input asp-for="PorcentajeITBIS"
                               class="form-control text-end fw-bold"
                               type="number" step="0.01" min="0" max="100"
                               placeholder="0.00" />
                        <span class="input-group-text fw-bold">%</span>
                    </div>
                    <span asp-validation-for="PorcentajeITBIS" class="text-danger fs-xs"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="PorcentajeTasaServicioAduanal" class="icp-field-label"></label>
                    <div class="input-group">
                        <input asp-for="PorcentajeTasaServicioAduanal"
                               class="form-control text-end fw-bold"
                               type="number" step="0.01" min="0" max="100"
                               placeholder="0.00" />
                        <span class="input-group-text fw-bold">%</span>
                    </div>
                    <span asp-validation-for="PorcentajeTasaServicioAduanal" class="text-danger fs-xs"></span>
                </div>

                <div class="icp-form-footer">
                    <button type="submit" class="btn-save">
                        <i class="bi bi-save me-1"></i> Guardar Configuración
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}