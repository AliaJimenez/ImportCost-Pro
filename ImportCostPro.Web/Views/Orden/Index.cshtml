@model IEnumerable<ImportCostPro.Core.ViewModels.Orden.OrdenIndexViewModel>

@{
    ViewData["Title"] = "Órdenes de Importación";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <div class="icp-page-icon" style="background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.2);">
            <i class="bi bi-file-earmark-ruled" style="color: var(--accent-cyan);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Órdenes de Importación</h1>
            <p class="icp-page-subtitle">Gestión de órdenes de compra internacional y cálculo de landed cost</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-icp-primary">
        <i class="bi bi-plus-lg"></i> Nueva Orden
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="icp-alert-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="icp-alert-danger mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
    </div>
}

<div class="icp-toolbar">
    <div class="icp-toolbar-left">
        <div class="icp-search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchOrden" placeholder="Buscar orden, importador, proveedor..." />
        </div>
        <div class="d-flex gap-1 ms-2">
            <button class="btn-icp-view filtro-btn active" data-filtro="todos">Todas</button>
            <button class="btn-icp-view filtro-btn" data-filtro="Abierta">Abiertas</button>
            <button class="btn-icp-view filtro-btn" data-filtro="Calculada">Calculadas</button>
            <button class="btn-icp-view filtro-btn" data-filtro="Cerrada">Cerradas</button>
        </div>
    </div>
    <div class="icp-toolbar-right">
        <span class="icp-count-label" id="countOrden">@Model.Count() registros</span>
    </div>
</div>

<div class="icp-table-wrapper">
    <div style="overflow-x: auto;">
        <table class="icp-table" style="min-width: 900px;">
            <thead>
                <tr>
                    <th style="width:12%;">N° Orden</th>
                    <th style="width:17%;">Importador</th>
                    <th style="width:15%;">Proveedor</th>
                    <th style="width:10%;">Moneda</th>
                    <th style="width:10%;">Fecha</th>
                    <th style="width:9%;" class="text-center">Estado</th>
                    <th style="width:27%;" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbodyOrden">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5" style="color: var(--text-muted);">
                            <i class="bi bi-file-earmark-ruled display-5 d-block mb-3" style="opacity: .25;"></i>
                            No hay órdenes de importación registradas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr class="orden-row" data-estado="@item.Estado">
                            <td>
                                <span class="icp-code-badge">@item.NumeroOrden</span>
                            </td>
                            <td class="fw-600" style="color: var(--text-primary);">
                                <i class="bi bi-person-badge me-1" style="color: var(--accent-green); font-size: 0.75rem;"></i>
                                @item.NombreImportador
                            </td>
                            <td style="color: var(--text-secondary);">
                                <i class="bi bi-truck me-1" style="color: var(--accent-purple); font-size: 0.75rem;"></i>
                                @item.NombreProveedor
                            </td>
                            <td>
                                <span class="icp-code-badge" style="color: var(--accent-orange);">@item.NombreMoneda</span>
                            </td>
                            <td style="color: var(--text-secondary); font-size: 0.8rem;">
                                @item.FechaCreacion.ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-center">
                                @if (item.Estado == "Abierta")
                                {
                                    <span class="icp-badge icp-badge-abierta">Abierta</span>
                                }
                                else if (item.Estado == "Calculada")
                                {
                                    <span class="icp-badge icp-badge-calculada">Calculada</span>
                                }
                                else if (item.Estado == "Cerrada")
                                {
                                    <span class="icp-badge icp-badge-cerrada">Cerrada</span>
                                }
                                else
                                {
                                    <span class="icp-badge icp-badge-danger">@item.Estado</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1 flex-wrap">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-icp-view">
                                        <i class="bi bi-eye"></i> Ver
                                    </a>
                                    @if (item.Estado == "Abierta")
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icp-edit">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                        <a asp-controller="CalculoLandedCost" asp-action="Calcular"
                                           class="btn-icp-view" style="background: rgba(16,185,129,0.08); color: #34d399; border-color: rgba(16,185,129,0.2);">
                                            <i class="bi bi-calculator"></i> Calcular
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icp-delete">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    }
                                    @if (item.Estado == "Calculada")
                                    {
                                        <a asp-action="CerrarOrden" asp-route-id="@item.Id"
                                           class="btn-icp-view" style="background: rgba(107,114,128,0.08); color: #9ca3af; border-color: rgba(107,114,128,0.2);"
                                           onclick="return confirm('¿Cerrar esta orden? Una vez cerrada no se podrá modificar.')">
                                            <i class="bi bi-lock-fill"></i> Cerrar
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    const rows = document.querySelectorAll('.orden-row');
    const countEl = document.getElementById('countOrden');
    let filtroActual = 'todos';

    function aplicarFiltros() {
        const q = document.getElementById('searchOrden').value.toLowerCase();
        let vis = 0;
        rows.forEach(function (r) {
            const estado = r.dataset.estado;
            const matchFiltro = filtroActual === 'todos' || estado === filtroActual;
            const matchSearch = r.textContent.toLowerCase().includes(q);
            const show = matchFiltro && matchSearch;
            r.style.display = show ? '' : 'none';
            if (show) vis++;
        });
        countEl.textContent = vis + ' registros';
    }

    document.getElementById('searchOrden').addEventListener('input', aplicarFiltros);
    document.querySelectorAll('.filtro-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.filtro-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            filtroActual = btn.dataset.filtro;
            aplicarFiltros();
        });
    });
</script>
}
