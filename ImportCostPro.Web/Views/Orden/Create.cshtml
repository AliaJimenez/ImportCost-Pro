@model ImportCostPro.Core.ViewModels.Orden.OrdenFormViewModel

@{
    ViewData["Title"] = "Nueva Orden de Importación";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-1">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <div class="icp-page-icon" style="background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.2);">
            <i class="bi bi-file-earmark-plus" style="color: var(--accent-cyan);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Nueva Orden de Importación</h1>
            <p class="icp-page-subtitle">Registra una nueva orden de compra internacional</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="icp-card">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="icp-alert-danger mb-4"></div>

                <span class="icp-form-section-label">
                    <i class="bi bi-info-circle me-2" style="color: var(--accent-cyan);"></i>
                    Identificación de la Orden
                </span>

                <div class="mb-4">
                    <label asp-for="NumeroOrden" class="icp-field-label"></label>
                    <input asp-for="NumeroOrden" class="form-control font-monospace" placeholder="Ej: ORD-2024-001" maxlength="50" />
                    <span asp-validation-for="NumeroOrden" class="text-danger fs-xs"></span>
                    <small class="d-block mt-1" style="color: var(--text-muted);">
                        <i class="bi bi-exclamation-circle me-1"></i>El número de orden debe ser único en el sistema.
                    </small>
                </div>

                <span class="icp-form-section-label">
                    <i class="bi bi-people me-2" style="color: var(--accent-blue);"></i>
                    Partes Involucradas
                </span>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="ImportadorId" class="icp-field-label">Importador</label>
                        <select asp-for="ImportadorId" asp-items="Model.Importadores" class="form-select" id="importadorSelect">
                            <option value="">— Seleccione importador —</option>
                        </select>
                        <span asp-validation-for="ImportadorId" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProveedorId" class="icp-field-label">Proveedor</label>
                        <select asp-for="ProveedorId" asp-items="Model.Proveedores" class="form-select" id="proveedorSelect">
                            <option value="">— Seleccione proveedor —</option>
                        </select>
                        <span asp-validation-for="ProveedorId" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <span class="icp-form-section-label">
                    <i class="bi bi-globe-americas me-2" style="color: var(--accent-green);"></i>
                    Origen y Finanzas
                </span>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="PaisOrigenId" class="icp-field-label">País de Origen</label>
                        <select asp-for="PaisOrigenId" asp-items="Model.Paises" class="form-select">
                            <option value="">— Seleccione país —</option>
                        </select>
                        <span asp-validation-for="PaisOrigenId" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MonedaId" class="icp-field-label">Moneda de la Orden</label>
                        <select asp-for="MonedaId" asp-items="Model.Monedas" class="form-select">
                            <option value="">— Seleccione moneda —</option>
                        </select>
                        <span asp-validation-for="MonedaId" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-4">
                        <label for="FechaOrden" class="icp-field-label">Fecha de la Orden</label>
                        <input type="date" name="FechaOrden" id="FechaOrden" class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label for="ModalidadTransporte" class="icp-field-label">Modalidad de Transporte</label>
                    <select name="ModalidadTransporte" id="ModalidadTransporte" class="form-select" required>
                        <option value="">— Seleccione modalidad —</option>
                        <option value="Maritimo">🚢 Marítimo</option>
                        <option value="Aereo">✈️ Aéreo</option>
                        <option value="Terrestre">🚛 Terrestre</option>
                    </select>
                </div>

                <div class="icp-toggle-panel mb-4">
                    <div class="icp-toggle-row">
                        <div>
                            <span class="fw-600 fs-sm" style="color: var(--text-secondary);">Estado</span>
                            <small class="d-block mt-1" style="color: var(--text-muted);">
                                El estado se asigna automáticamente como <strong style="color: var(--accent-cyan);">Abierta</strong> al crear la orden.
                            </small>
                        </div>
                        <span class="icp-badge icp-badge-abierta">
                            <i class="bi bi-circle-fill" style="font-size:0.45rem;"></i> Abierta
                        </span>
                    </div>
                </div>

                <div class="icp-form-footer">
                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn-save">
                        <i class="bi bi-check-lg me-1"></i> Crear Orden
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
