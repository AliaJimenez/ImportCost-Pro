@model ImportCostPro.Core.Dtos.OrdenImportacionDto

@{
    ViewData["Title"] = "Orden — " + Model.NumeroOrden;
    bool esAbierta    = Model.Estado == "Abierta";
    bool esCalculada  = Model.Estado == "Calculada";
    bool esCerrada    = Model.Estado == "Cerrada" || Model.Estado == "Cancelada";

    var productos = ViewBag.Productos as IEnumerable<ImportCostPro.Core.Dtos.OrdenProductoDto> ?? Enumerable.Empty<ImportCostPro.Core.Dtos.OrdenProductoDto>();
    var gastos    = ViewBag.Gastos    as IEnumerable<ImportCostPro.Core.Dtos.OrdenGastoDto>    ?? Enumerable.Empty<ImportCostPro.Core.Dtos.OrdenGastoDto>();
    var calculo   = ViewBag.Calculo   as ImportCostPro.Core.Dtos.CalculoLandedCostDto;

    decimal fobTotal = productos.Sum(p => p.FOBTotal);
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-1">
            <i class="bi bi-arrow-left"></i> Órdenes
        </a>
        <div class="icp-page-icon" style="background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.2);">
            <i class="bi bi-file-earmark-text" style="color: var(--accent-cyan);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Orden <span style="color: var(--accent-cyan);">@Model.NumeroOrden</span></h1>
            <p class="icp-page-subtitle">
                Creada el @Model.FechaCreacion.ToString("dd/MM/yyyy")
                @if (Model.FechaCierre.HasValue)
                {
                    <span> · Cerrada el @Model.FechaCierre.Value.ToString("dd/MM/yyyy")</span>
                }
            </p>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (Model.Estado == "Abierta")
        {
            <span class="icp-badge icp-badge-abierta">
                <i class="bi bi-circle-fill" style="font-size:0.45rem;"></i> Abierta
            </span>
        }
        else if (Model.Estado == "Calculada")
        {
            <span class="icp-badge icp-badge-calculada">
                <i class="bi bi-calculator" style="font-size:0.7rem;"></i> Calculada
            </span>
        }
        else if (Model.Estado == "Cerrada")
        {
            <span class="icp-badge icp-badge-cerrada">
                <i class="bi bi-lock-fill" style="font-size:0.7rem;"></i> Cerrada
            </span>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="icp-alert-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="icp-alert-danger mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
    </div>
}

@if (esCerrada)
{
    <div class="icp-alert-info mb-4">
        <i class="bi bi-info-circle-fill me-2"></i>
        Esta orden está <strong>@Model.Estado</strong> y se encuentra en modo solo lectura.
    </div>
}

<!-- ══ SECCIÓN 1: DATOS GENERALES ═══════════════════════════════════════ -->
<div class="icp-card mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <span class="icp-form-section-label mb-0">
            <i class="bi bi-info-circle me-2" style="color: var(--accent-cyan);"></i>
            Datos Generales
        </span>
        @if (esAbierta)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-icp-edit">
                <i class="bi bi-pencil-square"></i> Editar
            </a>
        }
    </div>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="icp-delete-preview">
                <div class="preview-row">
                    <span class="preview-label">Importador</span>
                    <span class="preview-value fw-600">
                        <i class="bi bi-person-badge me-1" style="color: var(--accent-green);"></i>
                        @Model.NombreImportador
                    </span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Proveedor</span>
                    <span class="preview-value fw-600">
                        <i class="bi bi-truck me-1" style="color: var(--accent-purple);"></i>
                        @Model.NombreProveedor
                    </span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">País Origen</span>
                    <span class="preview-value">
                        <i class="bi bi-geo-alt me-1" style="color: var(--accent-orange);"></i>
                        @Model.NombrePais
                    </span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Moneda</span>
                    <span class="preview-value">
                        <span class="icp-code-badge" style="color: var(--accent-orange);">@Model.NombreMoneda</span>
                    </span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="icp-delete-preview">
                <div class="preview-row">
                    <span class="preview-label">N° Orden</span>
                    <span class="preview-value"><span class="icp-code-badge">@Model.NumeroOrden</span></span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">Fecha Creación</span>
                    <span class="preview-value">@Model.FechaCreacion.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">FOB Total</span>
                    <span class="preview-value fw-700" style="color: var(--accent-cyan);">
                        @fobTotal.ToString("N2")
                    </span>
                </div>
                @if (Model.CIF.HasValue)
                {
                    <div class="preview-row">
                        <span class="preview-label">CIF Total</span>
                        <span class="preview-value fw-700" style="color: var(--accent-blue);">@Model.CIF.Value.ToString("N2")</span>
                    </div>
                }
            </div>
        </div>
        <div class="col-md-4">
            @if (Model.PrecioSugerido.HasValue)
            {
                <div class="icp-metric-card" style="--metric-accent: var(--accent-green);">
                    <div class="icp-metric-header">
                        <span class="icp-metric-label">Costo Total Importación</span>
                        <div class="icp-metric-icon" style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.2);">
                            <i class="bi bi-calculator-fill" style="color: var(--accent-green);"></i>
                        </div>
                    </div>
                    <div class="icp-metric-value" style="font-size: 1.4rem; color: var(--accent-green);">
                        @Model.PrecioSugerido.Value.ToString("N2")
                    </div>
                    <div class="icp-metric-desc">Resultado del cálculo oficial</div>
                </div>
            }
            else if (esAbierta)
            {
                <div class="icp-card" style="border-color: rgba(6,182,212,0.2); text-align: center; padding: 1.5rem;">
                    <i class="bi bi-calculator display-5 d-block mb-2" style="color: var(--accent-cyan); opacity: 0.5;"></i>
                    <div style="color: var(--text-muted); font-size: 0.82rem;">Pendiente de cálculo</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- ══ SECCIÓN 2: PRODUCTOS ═════════════════════════════════════════════ -->
<div class="icp-card mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <span class="icp-form-section-label mb-0">
            <i class="bi bi-tags me-2" style="color: var(--accent-orange);"></i>
            Productos de la Orden
        </span>
        @if (esAbierta)
        {
            <a asp-controller="OrdenProducto" asp-action="Create" asp-route-ordenId="@Model.Id" class="btn-icp-primary">
                <i class="bi bi-plus-lg"></i> Agregar Producto
            </a>
        }
    </div>

    <div class="icp-table-wrapper">
        <div style="overflow-x: auto;">
            <table class="icp-table" style="min-width: 750px;">
                <thead>
                    <tr>
                        <th style="width:28%;">Producto</th>
                        <th style="width:10%;" class="text-center">Cantidad</th>
                        <th style="width:13%;" class="text-end">Precio FOB Unit.</th>
                        <th style="width:13%;" class="text-end">FOB Total</th>
                        <th style="width:10%;" class="text-end">Peso Total</th>
                        <th style="width:10%;" class="text-center">Margen %</th>
                        @if (esAbierta)
                        {
                            <th style="width:16%;" class="text-end">Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!productos.Any())
                    {
                        <tr>
                            <td colspan="@(esAbierta ? 7 : 6)" class="text-center py-4" style="color: var(--text-muted);">
                                <i class="bi bi-tags display-5 d-block mb-2" style="opacity:.25;"></i>
                                No hay productos en esta orden.
                                @if (esAbierta) { <span>Use el botón <strong>Agregar Producto</strong> para comenzar.</span> }
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var prod in productos)
                        {
                            <tr>
                                <td class="fw-600" style="color: var(--text-primary);">
                                    <i class="bi bi-box-seam me-1" style="color: var(--accent-blue); font-size: 0.75rem;"></i>
                                    @prod.NombreProducto
                                    <div style="font-size: 0.68rem; color: var(--text-muted);">@prod.CodigoProducto</div>
                                </td>
                                <td class="text-center">@prod.Cantidad.ToString("N0")</td>
                                <td class="text-end" style="color: var(--text-secondary);">@prod.PrecioUnitarioFOB.ToString("N4")</td>
                                <td class="text-end fw-600" style="color: var(--accent-cyan);">@prod.FOBTotal.ToString("N2")</td>
                                <td class="text-end" style="color: var(--text-secondary);">@prod.PesoTotal.ToString("N3") kg</td>
                                <td class="text-center">
                                    <span class="icp-rate-blue">@prod.MargenGananciaDeseado.ToString("N1")%</span>
                                </td>
                                @if (esAbierta)
                                {
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-1">
                                            <a asp-controller="OrdenProducto" asp-action="Edit" asp-route-id="@prod.Id" class="btn-icp-edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-controller="OrdenProducto" asp-action="Delete" asp-route-id="@prod.Id" class="btn-icp-delete">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                        <tr style="background: rgba(6,182,212,0.04); border-top: 1px solid rgba(6,182,212,0.2);">
                            <td class="fw-700" style="color: var(--text-primary);" colspan="3">
                                <i class="bi bi-sigma me-1" style="color: var(--accent-cyan);"></i> TOTALES
                            </td>
                            <td class="text-end fw-700" style="color: var(--accent-cyan);">@fobTotal.ToString("N2")</td>
                            <td class="text-end fw-700" style="color: var(--text-secondary);">
                                @productos.Sum(p => p.PesoTotal).ToString("N3") kg
                            </td>
                            <td colspan="@(esAbierta ? 2 : 1)"></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ══ SECCIÓN 3: GASTOS ═════════════════════════════════════════════════ -->
<div class="icp-card mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <span class="icp-form-section-label mb-0">
            <i class="bi bi-receipt me-2" style="color: var(--accent-purple);"></i>
            Gastos de Importación
        </span>
        @if (esAbierta)
        {
            <a asp-controller="OrdenGasto" asp-action="Create" asp-route-ordenId="@Model.Id" class="btn-icp-primary"
               style="background: var(--accent-purple); box-shadow: 0 2px 8px rgba(139,92,246,0.25);">
                <i class="bi bi-plus-lg"></i> Registrar Gasto
            </a>
        }
    </div>

    <div class="icp-table-wrapper">
        <table class="icp-table">
            <thead>
                <tr>
                    <th style="width:30%;">Tipo de Gasto</th>
                    <th style="width:18%;" class="text-end">Monto</th>
                    <th style="width:15%;">Moneda</th>
                    <th style="width:22%;">Distribución</th>
                    <th style="width:10%;">Fecha</th>
                    @if (esAbierta)
                    {
                        <th style="width:5%;" class="text-end"></th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!gastos.Any())
                {
                    <tr>
                        <td colspan="@(esAbierta ? 6 : 5)" class="text-center py-4" style="color: var(--text-muted);">
                            <i class="bi bi-receipt display-5 d-block mb-2" style="opacity:.25;"></i>
                            No hay gastos registrados para esta orden.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var gasto in gastos)
                    {
                        <tr>
                            <td class="fw-600">
                                <i class="bi bi-tag-fill me-1" style="color: var(--accent-purple); font-size: 0.75rem;"></i>
                                @gasto.TipoGasto
                            </td>
                            <td class="text-end fw-600" style="color: var(--accent-orange);">
                                @gasto.SimboloMoneda @gasto.Monto.ToString("N2")
                            </td>
                            <td><span class="icp-code-badge">@gasto.NombreMoneda</span></td>
                            <td style="color: var(--text-secondary); font-size: 0.8rem;">@gasto.MetodoDistribucion</td>
                            <td style="color: var(--text-muted); font-size: 0.8rem;">@gasto.FechaGasto.ToString("dd/MM/yy")</td>
                            @if (esAbierta)
                            {
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-controller="OrdenGasto" asp-action="Edit" asp-route-id="@gasto.Id" class="btn-icp-edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-controller="OrdenGasto" asp-action="Delete" asp-route-id="@gasto.Id" class="btn-icp-delete">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ══ SECCIÓN 4: RESULTADO LANDED COST (si existe) ═════════════════════ -->
@if (calculo != null)
{
    <div class="icp-card mb-4" style="border-color: rgba(16,185,129,0.2);">
        <span class="icp-form-section-label">
            <i class="bi bi-graph-up-arrow me-2" style="color: var(--accent-green);"></i>
            Resultado del Cálculo de Landed Cost
        </span>
        <div class="row g-3">
            <div class="col-sm-6 col-md-3">
                <div style="background: rgba(6,182,212,0.06); border: 1px solid rgba(6,182,212,0.15); border-radius: var(--radius-lg); padding: 0.85rem;">
                    <div style="font-size: 0.67rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em;">FOB Total Local</div>
                    <div style="font-size: 1.2rem; font-weight: 700; color: var(--accent-cyan);">@calculo.FobTotalLocal.ToString("N2")</div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div style="background: rgba(59,130,246,0.06); border: 1px solid rgba(59,130,246,0.15); border-radius: var(--radius-lg); padding: 0.85rem;">
                    <div style="font-size: 0.67rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em;">CIF Total</div>
                    <div style="font-size: 1.2rem; font-weight: 700; color: var(--accent-blue);">@calculo.CifTotalLocal.ToString("N2")</div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div style="background: rgba(245,158,11,0.06); border: 1px solid rgba(245,158,11,0.15); border-radius: var(--radius-lg); padding: 0.85rem;">
                    <div style="font-size: 0.67rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em;">Total Impuestos</div>
                    <div style="font-size: 1.2rem; font-weight: 700; color: var(--accent-orange);">
                        @((calculo.TotalArancel + calculo.TotalIsc + calculo.TotalTasaServicio + calculo.TotalItbis).ToString("N2"))
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div style="background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.2); border-radius: var(--radius-lg); padding: 0.85rem;">
                    <div style="font-size: 0.67rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em;">Costo Total</div>
                    <div style="font-size: 1.2rem; font-weight: 700; color: var(--accent-green);">@calculo.CostoTotalImportacion.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ══ SECCIÓN 5: BOTONES DE ACCIÓN ══════════════════════════════════════ -->
@if (!esCerrada)
{
    <div class="icp-card" style="border-color: rgba(255,255,255,0.06);">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            @if (esAbierta)
            {
                <a asp-controller="CalculoLandedCost" asp-action="Calcular"
                   class="btn-save" style="background: var(--accent-green); box-shadow: 0 2px 8px rgba(16,185,129,0.25);">
                    <i class="bi bi-calculator me-1"></i> Calcular Landed Cost
                </a>
            }
            @if (esCalculada)
            {
                <button type="button" class="btn-save" data-bs-toggle="modal" data-bs-target="#modalCerrar">
                    <i class="bi bi-lock-fill me-1"></i> Cerrar Orden
                </button>
            }
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-cancel" style="border-color: rgba(239,68,68,0.2); color: #fca5a5;">
                <i class="bi bi-trash3 me-1"></i> Eliminar Orden
            </a>
        </div>
    </div>
}

<!-- ══ MODAL: CERRAR ORDEN ═══════════════════════════════════════════════ -->
@if (esCalculada)
{
    <div class="modal fade" id="modalCerrar" tabindex="-1" aria-labelledby="modalCerrarLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-xl);">
                <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                    <h5 class="modal-title" id="modalCerrarLabel" style="color: var(--text-primary); font-size: 1rem; font-weight: 600;">
                        <i class="bi bi-lock-fill me-2" style="color: var(--accent-orange);"></i>
                        Confirmar Cierre de Orden
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="icp-alert-warning mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>¿Está seguro que desea cerrar esta orden de importación?</strong>
                    </div>
                    <p style="color: var(--text-secondary); font-size: 0.85rem;">
                        Una vez cerrada, <strong>no podrá modificar</strong> sus datos, productos, gastos ni resultado de cálculo.
                        Esta acción es <strong>irreversible</strong>.
                    </p>
                    <div class="icp-delete-preview mt-3">
                        <div class="preview-row">
                            <span class="preview-label">N° Orden</span>
                            <span class="preview-value fw-600">@Model.NumeroOrden</span>
                        </div>
                        <div class="preview-row">
                            <span class="preview-label">Estado actual</span>
                            <span class="preview-value"><span class="icp-badge icp-badge-calculada">Calculada</span></span>
                        </div>
                        <div class="preview-row">
                            <span class="preview-label">Nuevo estado</span>
                            <span class="preview-value"><span class="icp-badge icp-badge-cerrada">Cerrada</span></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </button>
                    <form asp-action="CerrarOrden" asp-route-id="@Model.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-save">
                            <i class="bi bi-lock-fill me-1"></i> Confirmar Cierre
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
