@model ImportCostPro.Core.ViewModels.TasaCambioViewModel

@{
    ViewData["Title"] = "Editar Tasa de Cambio";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-1">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <div class="icp-page-icon" style="background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.2);">
            <i class="bi bi-pencil-square" style="color: var(--accent-cyan);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Editar Tasa de Cambio</h1>
            <p class="icp-page-subtitle">Actualiza el multiplicador oficial de conversión</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="icp-card">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="icp-alert-danger mb-4"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="MonedaOrigenId" class="icp-field-label">Moneda de Origen</label>
                        <select asp-for="MonedaOrigenId" asp-items="ViewBag.MonedasOrigen" class="form-select">
                            <option value="">-- Seleccione divisa --</option>
                        </select>
                        <span asp-validation-for="MonedaOrigenId" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MonedaDestinoId" class="icp-field-label">Moneda Destino</label>
                        <select asp-for="MonedaDestinoId" asp-items="ViewBag.MonedasDestino" class="form-select">
                            <option value="">-- Seleccione moneda base --</option>
                        </select>
                        <span asp-validation-for="MonedaDestinoId" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Tasa" class="icp-field-label">Tasa Multiplicadora</label>
                        <div class="input-group">
                            <span class="input-group-text fw-bold"><i class="bi bi-x-lg"></i></span>
                            <input asp-for="Tasa" class="form-control text-end fw-bold fs-5"
                                   placeholder="0.0000" type="number" step="0.0001" />
                        </div>
                        <span asp-validation-for="Tasa" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FechaVigencia" class="icp-field-label">Fecha Efectiva</label>
                        <input asp-for="FechaVigencia" class="form-control" type="date" />
                        <span asp-validation-for="FechaVigencia" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <div class="icp-form-footer">
                    <a asp-action="Index" class="btn-cancel">Cancelar</a>
                    <button type="submit" class="btn-save btn-save-cyan">
                        <i class="bi bi-check-lg me-1"></i> Aplicar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}