@model ImportCostPro.Core.ViewModels.Proveedor.ProveedorEditViewModel

@{
    ViewData["Title"] = "Editar Proveedor";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-1">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <div class="icp-page-icon" style="background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.2);">
            <i class="bi bi-pencil-square" style="color: var(--accent-cyan);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Editar Proveedor</h1>
            <p class="icp-page-subtitle">Actualiza las propiedades de la cuenta extranjera</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="icp-card">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="TieneOrdenes" />
                <div asp-validation-summary="ModelOnly" class="icp-alert-danger mb-4"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="icp-field-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger fs-xs"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="PaisOrigenId" class="icp-field-label">País Ubicación</label>
                        @if (Model.TieneOrdenes)
                        {
                            <input type="hidden" asp-for="PaisOrigenId" />
                            <input class="form-control" readonly value="@Model.NombrePais" />
                            <small style="color: var(--accent-orange);">* No editable: posee transacciones vinculadas.</small>
                        }
                        else
                        {
                            <select asp-for="PaisOrigenId" asp-items="Model.Paises" class="form-select"></select>
                        }
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MonedaPrincipalId" class="icp-field-label">Moneda Facturación</label>
                        @if (Model.TieneOrdenes)
                        {
                            <input type="hidden" asp-for="MonedaPrincipalId" />
                            <input class="form-control" readonly value="@Model.NombreMoneda" />
                        }
                        else
                        {
                            <select asp-for="MonedaPrincipalId" asp-items="Model.Monedas" class="form-select"></select>
                        }
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Contacto" class="icp-field-label"></label>
                        <input asp-for="Contacto" class="form-control" />
                        <span asp-validation-for="Contacto" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Telefono" class="icp-field-label"></label>
                        <input asp-for="Telefono" class="form-control" />
                        <span asp-validation-for="Telefono" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="icp-field-label"></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger fs-xs"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Direccion" class="icp-field-label"></label>
                    <textarea asp-for="Direccion" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Direccion" class="text-danger fs-xs"></span>
                </div>

                <div class="icp-toggle-panel mb-4">
                    <div class="icp-toggle-row">
                        <label asp-for="Activo" class="fw-600 fs-sm" style="color:var(--text-primary);">Suplidor Habilitado</label>
                        <input asp-for="Activo" class="form-check-input ms-3 fs-5" type="checkbox" role="switch" />
                    </div>
                </div>

                <div class="icp-form-footer">
                    <a asp-action="Index" class="btn-cancel">Cancelar</a>
                    <button type="submit" class="btn-save btn-save-cyan">
                        <i class="bi bi-check-lg me-1"></i> Aplicar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}