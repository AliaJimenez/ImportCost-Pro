@model ImportCostPro.Core.ViewModels.Proveedor.ProveedorEditViewModel

@{
    ViewData["Title"] = "Editar Proveedor";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1>Editar Proveedor</h1>
            <hr />

            @if (Model.TieneOrdenes)
            {
                <div class="alert alert-warning" role="alert">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Atención:</strong> Este proveedor tiene órdenes de importación.
                    No puede cambiar el país ni la moneda.
                </div>
            }

            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">País Origen</label>
                    <input type="text" class="form-control" value="@Model.NombrePais" disabled />
                    @if (Model.TieneOrdenes)
                    {
                        <input type="hidden" name="PaisOrigenId" value="@Model.PaisOrigenId" />
                    }
                    else
                    {
                        <select asp-for="PaisOrigenId" asp-items="Model.Paises" class="form-control">
                            <option value="">-- Seleccionar País --</option>
                        </select>
                        <span asp-validation-for="PaisOrigenId" class="text-danger"></span>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">Moneda Principal</label>
                    <input type="text" class="form-control" value="@Model.NombreMoneda" disabled />
                    @if (Model.TieneOrdenes)
                    {
                        <input type="hidden" name="MonedaPrincipalId" value="@Model.MonedaPrincipalId" />
                    }
                    else
                    {
                        <select asp-for="MonedaPrincipalId" asp-items="Model.Monedas" class="form-control">
                            <option value="">-- Seleccionar Moneda --</option>
                        </select>
                        <span asp-validation-for="MonedaPrincipalId" class="text-danger"></span>
                    }
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Telefono" class="form-control" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Contacto" class="form-label">Contacto</label>
                    <input asp-for="Contacto" class="form-control" />
                    <span asp-validation-for="Contacto" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Direccion" class="form-label">Dirección</label>
                    <input asp-for="Direccion" class="form-control" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Activo" class="form-check-input" />
                    <label asp-for="Activo" class="form-check-label">Activo</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Guardar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}