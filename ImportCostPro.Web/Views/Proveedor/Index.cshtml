@* Views/Proveedor/Index.cshtml *@
@model IEnumerable<ImportCostPro.Core.ViewModels.Proveedor.ProveedorIndexViewModel>

@{
    ViewData["Title"] = "Proveedores";
    Layout = "_Layout";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <div class="icp-page-icon" style="background: rgba(139,92,246,0.12); border: 1px solid rgba(139,92,246,0.2);">
            <i class="bi bi-truck" style="color: var(--accent-purple);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Proveedores</h1>
            <p class="icp-page-subtitle">Suplidores internacionales registrados</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-icp-primary">
        <i class="bi bi-plus-lg"></i> Nuevo Proveedor
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="icp-alert-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="icp-alert-danger mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
    </div>
}

<div class="icp-toolbar">
    <div class="icp-toolbar-left">
        <div class="icp-search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchProv" placeholder="Buscar proveedor, país, moneda..." />
        </div>
        <div class="d-flex gap-1 ms-2">
            <button class="btn-icp-view filtro-btn active" data-filtro="todos">Todos</button>
            <button class="btn-icp-view filtro-btn" data-filtro="true">Activos</button>
            <button class="btn-icp-view filtro-btn" data-filtro="false">Inactivos</button>
        </div>
    </div>
    <div class="icp-toolbar-right">
        <span class="icp-count-label" id="countProv">@Model.Count() registros</span>
    </div>
</div>

<div class="icp-table-wrapper">
    <table class="icp-table">
        <thead>
            <tr>
                <th style="width:20%;">Nombre del Suplidor</th>
                <th style="width:12%;">Corre Electronico</th>
                <th style="width:12%;">Telefono</th>
                <th style="width:20%;">País Origen</th>
                <th style="width:18%;">Moneda</th>
                <th style="width:12%;">Estado</th>
                <th style="width:20%;" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody id="tbodyProv">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-5" style="color: var(--text-muted);">
                        <i class="bi bi-globe-americas display-5 d-block mb-3" style="opacity: .25;"></i>
                        No hay proveedores internacionales registrados.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr class="prov-row" data-activo="@item.Activo.ToString().ToLower()">
                        <td class="fw-600" style="color: var(--text-primary);">
                            <i class="bi bi-truck me-2" style="color: var(--accent-purple); font-size: 0.75rem;"></i>
                            @item.Nombre
                            @if (item.TieneOrdenes)
                            {
                                <span class="icp-badge ms-1" style="background:rgba(59,130,246,0.1);color:#60a5fa;border:1px solid rgba(59,130,246,0.2);font-size:0.6rem;">
                                    <i class="bi bi-box-seam" style="font-size:0.5rem;"></i> Con órdenes
                                </span>
                            }
                        </td>
                        <td>
                            <span class="icp-code-badge" style="color: var(--accent-orange);">@item.Email</span>
                        </td>
                        <td>
                            <span class="icp-code-badge" style="color: var(--accent-orange);">@item.Telefono</span>
                        </td>
                        <td>
                            <span style="color: var(--text-secondary);">
                                <i class="bi bi-geo-alt me-1" style="color: var(--accent-cyan); font-size: 0.75rem;"></i>@item.NombrePais
                            </span>
                        </td>
                        <td>
                            <span class="icp-code-badge" style="color: var(--accent-orange);">@item.NombreMoneda</span>
                        </td>
                        <td>
                            @if (item.Activo)
                            {
                                <span class="icp-badge icp-badge-success">
                                    <i class="bi bi-check-circle-fill" style="font-size:0.55rem;"></i> Activo
                                </span>
                            }
                            else
                            {
                                <span class="icp-badge icp-badge-cerrada">
                                    <i class="bi bi-x-circle-fill" style="font-size:0.55rem;"></i> Inactivo
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icp-edit">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icp-delete">
                                    <i class="bi bi-trash3"></i> Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    const rows = document.querySelectorAll('.prov-row');
    const countEl = document.getElementById('countProv');
    let filtroActual = 'todos';

    function aplicarFiltros() {
        const q = document.getElementById('searchProv').value.toLowerCase();
        let vis = 0;
        rows.forEach(function (r) {
            const activo = r.dataset.activo;
            const matchFiltro = filtroActual === 'todos' || activo === filtroActual;
            const matchSearch = r.textContent.toLowerCase().includes(q);
            const show = matchFiltro && matchSearch;
            r.style.display = show ? '' : 'none';
            if (show) vis++;
        });
        countEl.textContent = vis + ' registros';
    }

    document.getElementById('searchProv').addEventListener('input', aplicarFiltros);
    document.querySelectorAll('.filtro-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.filtro-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            filtroActual = btn.dataset.filtro;
            aplicarFiltros();
        });
    });
</script>
}