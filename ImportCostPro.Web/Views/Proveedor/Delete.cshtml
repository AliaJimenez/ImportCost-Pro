@model ImportCostPro.Core.ViewModels.Proveedor.ProveedorFormViewModel

@{
    ViewData["Title"] = "Eliminar Proveedor";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-1">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <div class="icp-page-icon" style="background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.2);">
            <i class="bi bi-exclamation-octagon-fill" style="color: var(--accent-red);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Eliminar Proveedor</h1>
            <p class="icp-page-subtitle">Esta acción removerá el perfil transaccional del suplidor</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="icp-card" style="border-color: rgba(239,68,68,0.25);">
            <div class="icp-alert-danger mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Esta acción es irreversible. Verifique que no existan órdenes de compra activas vinculadas.
            </div>

            <div class="icp-delete-preview mb-4">
                <div class="preview-row">
                    <span class="preview-label">Suplidor</span>
                    <span class="preview-value fw-600">@Model.Nombre</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Contacto))
                {
                    <div class="preview-row">
                        <span class="preview-label">Contacto</span>
                        <span class="preview-value" style="color: var(--text-secondary);">@Model.Contacto</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <div class="preview-row">
                        <span class="preview-label">Email</span>
                        <span class="preview-value fs-sm" style="color: var(--text-muted);">@Model.Email</span>
                    </div>
                }
                <div class="preview-row">
                    <span class="preview-label">Estado</span>
                    <span class="preview-value">
                        @if (Model.Activo)
                        {
                            <span class="icp-badge icp-badge-success">Activo</span>
                        }
                        else
                        {
                            <span class="icp-badge icp-badge-cerrada">Inactivo</span>
                        }
                    </span>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-danger fw-semibold px-4">
                        <i class="bi bi-trash3-fill me-1"></i> Eliminar Definitivamente
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>