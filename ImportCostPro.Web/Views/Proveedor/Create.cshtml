@model ImportCostPro.Core.ViewModels.Proveedor.ProveedorFormViewModel

@{
    ViewData["Title"] = "Registrar Proveedor";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-1">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <div class="icp-page-icon" style="background: rgba(139,92,246,0.12); border: 1px solid rgba(139,92,246,0.2);">
            <i class="bi bi-truck" style="color: var(--accent-purple);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Registrar Proveedor</h1>
            <p class="icp-page-subtitle">Establece la moneda base de compra para automatizar la conversión del FOB</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="icp-card">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="icp-alert-danger mb-4"></div>

                <span class="icp-form-section-label">Datos del Suplidor</span>

                <div class="mb-3">
                    <label asp-for="Nombre" class="icp-field-label"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Global Logistics &amp; Tech Inc." />
                    <span asp-validation-for="Nombre" class="text-danger fs-xs"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="PaisOrigenId" class="icp-field-label">País de Ubicación</label>
                        <select asp-for="PaisOrigenId" asp-items="Model.Paises" class="form-select">
                            <option value="">-- Seleccione Región --</option>
                        </select>
                        <span asp-validation-for="PaisOrigenId" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MonedaPrincipalId" class="icp-field-label">Moneda de Facturación</label>
                        <select asp-for="MonedaPrincipalId" asp-items="Model.Monedas" class="form-select">
                            <option value="">-- Seleccione Moneda --</option>
                        </select>
                        <span asp-validation-for="MonedaPrincipalId" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <span class="icp-form-section-label">Contacto</span>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Contacto" class="icp-field-label"></label>
                        <input asp-for="Contacto" class="form-control" placeholder="John Doe" />
                        <span asp-validation-for="Contacto" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Telefono" class="icp-field-label"></label>
                        <input asp-for="Telefono" class="form-control" placeholder="+1 415-555-0132" />
                        <span asp-validation-for="Telefono" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="icp-field-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="orders@supplier.com" type="email" />
                    <span asp-validation-for="Email" class="text-danger fs-xs"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Direccion" class="icp-field-label"></label>
                    <textarea asp-for="Direccion" class="form-control" rows="2" placeholder="Dirección en origen..."></textarea>
                    <span asp-validation-for="Direccion" class="text-danger fs-xs"></span>
                </div>

                <div class="icp-form-footer">
                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn-save">
                        <i class="bi bi-check-lg me-1"></i> Guardar Proveedor
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}