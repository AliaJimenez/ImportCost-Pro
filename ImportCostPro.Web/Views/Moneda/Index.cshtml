@model IEnumerable<ImportCostPro.Core.Dtos.MonedaDto>

@{
    ViewData["Title"] = "Monedas";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <div class="icp-page-icon" style="background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.2);">
            <i class="bi bi-currency-dollar" style="color: var(--accent-green);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Monedas</h1>
            <p class="icp-page-subtitle">Monedas disponibles para transacciones internacionales</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-icp-primary">
        <i class="bi bi-plus-lg"></i> Crear Moneda
    </a>
</div>

<div class="icp-toolbar">
    <div class="icp-toolbar-left">
        <div class="icp-search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchMoneda" placeholder="Buscar moneda..." />
        </div>
    </div>
    <div class="icp-toolbar-right">
        <span class="icp-count-label" id="countLabel">@Model.Count() registros</span>
    </div>
</div>

<div class="icp-table-wrapper">
    <table class="icp-table" id="tablaMonedas">
        <thead>
            <tr>
                <th style="width:40%;">Nombre</th>
                <th style="width:20%;">Código</th>
                <th style="width:15%;">Símbolo</th>
                <th style="width:25%;" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr id="emptyRow">
                    <td colspan="4" class="text-center py-5" style="color: var(--text-muted);">
                        <i class="bi bi-cash-stack display-5 d-block mb-3" style="opacity: .25;"></i>
                        No hay monedas registradas en el sistema.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr class="moneda-row">
                        <td>
                            <span class="fw-600" style="color: var(--text-primary);">@item.Nombre</span>
                            @if (item.EsMonedaLocal)
                            {
                                <span class="icp-badge icp-badge-success ms-2">
                                    <i class="bi bi-star-fill" style="font-size: 0.6rem;"></i> Base
                                </span>
                            }
                        </td>
                        <td><span class="icp-code-badge">@item.CodigoISO</span></td>
                        <td class="fw-bold fs-5" style="color: var(--accent-orange);">@item.Simbolo</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icp-edit">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icp-delete">
                                    <i class="bi bi-trash3"></i> Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    var rows = document.querySelectorAll('.moneda-row');
    document.getElementById('searchMoneda')?.addEventListener('input', function () {
        var q = this.value.toLowerCase(); var vis = 0;
        rows.forEach(function (r) {
            var show = r.textContent.toLowerCase().includes(q);
            r.style.display = show ? '' : 'none';
            if (show) vis++;
        });
        document.getElementById('countLabel').textContent = vis + ' registros';
    });
</script>
}