@model ImportCostPro.Core.ViewModels.MonedaViewModel

@{
    ViewData["Title"] = "Editar Moneda";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-1">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <div class="icp-page-icon" style="background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.2);">
            <i class="bi bi-pencil-square" style="color: var(--accent-cyan);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Editar Moneda</h1>
            <p class="icp-page-subtitle">Actualiza las propiedades del activo monetario</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="icp-card">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="icp-alert-danger mb-4"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-3 mb-3">
                    <div class="col-md-5">
                        <label asp-for="CodigoISO" class="icp-field-label"></label>
                        <input asp-for="CodigoISO" class="form-control font-monospace" readonly />
                        <span asp-validation-for="CodigoISO" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Simbolo" class="icp-field-label"></label>
                        <input asp-for="Simbolo" class="form-control" />
                        <span asp-validation-for="Simbolo" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Nombre" class="icp-field-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger fs-xs"></span>
                </div>

                <div class="icp-toggle-panel mb-3">
                    <div class="icp-toggle-row">
                        <div>
                            <label asp-for="EsMonedaLocal" class="fw-600 fs-sm" style="color: var(--text-primary);"></label>
                            <small class="d-block mt-1" style="color: var(--text-muted);">Al activar, se reajustará la matriz de conversión general.</small>
                        </div>
                        <input asp-for="EsMonedaLocal" class="form-check-input ms-3 fs-4" type="checkbox" role="switch" />
                    </div>
                </div>

                <div class="mb-5">
                    <div class="form-check form-switch icp-switch">
                        <input asp-for="Activo" class="form-check-input" type="checkbox" />
                        <label asp-for="Activo" class="form-check-label fw-bold">Moneda Activa en el sistema</label>
                    </div>
                </div>

                <div class="icp-form-footer">
                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn-save btn-save-cyan">
                        <i class="bi bi-check-lg me-1"></i> Aplicar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}