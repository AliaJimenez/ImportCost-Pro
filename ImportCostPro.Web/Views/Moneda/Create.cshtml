@model ImportCostPro.Core.ViewModels.MonedaViewModel

@{
    ViewData["Title"] = "Registrar Moneda";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-1">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <div class="icp-page-icon" style="background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.2);">
            <i class="bi bi-currency-dollar" style="color: var(--accent-green);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Registrar Moneda</h1>
            <p class="icp-page-subtitle">Agrega un nuevo activo monetario al sistema</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="icp-card">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="icp-alert-danger mb-4"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-5">
                        <label asp-for="CodigoISO" class="icp-field-label"></label>
                        <input asp-for="CodigoISO" class="form-control font-monospace"
                               placeholder="USD" maxlength="3" />
                        <span asp-validation-for="CodigoISO" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Simbolo" class="icp-field-label"></label>
                        <input asp-for="Simbolo" class="form-control" placeholder="$" maxlength="5" />
                        <span asp-validation-for="Simbolo" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Nombre" class="icp-field-label"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Dólar Estadounidense" />
                    <span asp-validation-for="Nombre" class="text-danger fs-xs"></span>
                </div>

                <div class="icp-toggle-panel mb-5">
                    <div class="icp-toggle-row">
                        <div>
                            <label asp-for="EsMonedaLocal" class="fw-600 fs-sm" style="color: var(--text-primary); cursor: pointer;"></label>
                            <small class="d-block mt-1" style="color: var(--text-muted);">Si se activa, esta será la moneda de reporte oficial del sistema.</small>
                        </div>
                        <input asp-for="EsMonedaLocal" class="form-check-input ms-3 fs-4" type="checkbox" role="switch" style="cursor: pointer;" />
                    </div>
                </div>

                <div class="icp-form-footer">
                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn-save">
                        <i class="bi bi-check-lg me-1"></i> Guardar Moneda
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}