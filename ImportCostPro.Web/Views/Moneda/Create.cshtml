@model ImportCostPro.Core.ViewModels.MonedaViewModel

@{
    ViewData["Title"] = "Nueva Moneda";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Registrar Nueva Moneda</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                        <div class="mb-3">
                            <label asp-for="CodigoISO" class="form-label fw-bold"></label>
                            <input asp-for="CodigoISO" class="form-control text-uppercase" placeholder="Ej. USD, DOP, EUR" />
                            <span asp-validation-for="CodigoISO" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Dólar Estadounidense" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Simbolo" class="form-label fw-bold"></label>
                            <input asp-for="Simbolo" class="form-control" placeholder="Ej. $, RD$, €" />
                            <span asp-validation-for="Simbolo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check form-switch">
                            <input asp-for="EsMonedaLocal" class="form-check-input" type="checkbox" role="switch">
                            <label asp-for="EsMonedaLocal" class="form-check-label fw-bold"></label>
                        </div>

                        <div class="mb-4 form-check form-switch">
                            <input asp-for="Activo" class="form-check-input" type="checkbox" role="switch" checked>
                            <label asp-for="Activo" class="form-check-label fw-bold"></label>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left-circle"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save"></i> Guardar Moneda
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}