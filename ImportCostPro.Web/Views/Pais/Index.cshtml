@* Views/Pais/Index.cshtml *@
@model IEnumerable<ImportCostPro.Core.ViewModels.Pais.PaisIndexViewModel>

@{
    ViewData["Title"] = "Países";
    Layout = "_Layout";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <div class="icp-page-icon" style="background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.2);">
            <i class="bi bi-globe-americas" style="color: var(--accent-cyan);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Países</h1>
            <p class="icp-page-subtitle">Países de origen registrados para importaciones</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-icp-primary">
        <i class="bi bi-plus-lg"></i> Crear País
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="icp-alert-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="icp-alert-danger mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
    </div>
}

<div class="icp-toolbar">
    <div class="icp-toolbar-left">
        <div class="icp-search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchPais" placeholder="Buscar país o código ISO..." />
        </div>
        <div class="d-flex gap-1 ms-2">
            <button class="btn-icp-view filtro-btn active" data-filtro="todos" id="btnTodos">Todos</button>
            <button class="btn-icp-view filtro-btn" data-filtro="activo" id="btnActivos">Activos</button>
            <button class="btn-icp-view filtro-btn" data-filtro="inactivo" id="btnInactivos">Inactivos</button>
        </div>
    </div>
    <div class="icp-toolbar-right">
        <span class="icp-count-label" id="countPais">@Model.Count() registros</span>
    </div>
</div>

<div class="icp-table-wrapper">
    <table class="icp-table">
        <thead>
            <tr>
                <th style="width:45%;">País</th>
                <th style="width:20%;">Código ISO</th>
                <th style="width:15%;">Estado</th>
                <th style="width:20%;" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody id="tbodyPais">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center py-5" style="color: var(--text-muted);">
                        <i class="bi bi-globe display-5 d-block mb-3" style="opacity: .25;"></i>
                        No hay países registrados en el sistema.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr class="pais-row" data-activo="@item.Activo.ToString().ToLower()">
                        <td class="fw-600" style="color: var(--text-primary);">
                            <i class="bi bi-geo-alt-fill me-2" style="color: var(--accent-cyan); font-size: 0.75rem;"></i>
                            @item.Nombre
                        </td>
                        <td><span class="icp-code-badge">@item.CodigoISO</span></td>
                        <td>
                            @if (item.Activo)
                            {
                                <span class="icp-badge icp-badge-success">
                                    <i class="bi bi-check-circle-fill" style="font-size:0.55rem;"></i> Activo
                                </span>
                            }
                            else
                            {
                                <span class="icp-badge icp-badge-cerrada">
                                    <i class="bi bi-x-circle-fill" style="font-size:0.55rem;"></i> Inactivo
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icp-edit">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icp-delete">
                                    <i class="bi bi-trash3"></i> Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    const rows = document.querySelectorAll('.pais-row');
    const countEl = document.getElementById('countPais');
    let filtroActual = 'todos';

    function aplicarFiltros() {
        const q = document.getElementById('searchPais').value.toLowerCase();
        let vis = 0;
        rows.forEach(function (r) {
            const activo = r.dataset.activo;
            const matchFiltro = filtroActual === 'todos' || activo === filtroActual;
            const matchSearch = r.textContent.toLowerCase().includes(q);
            const show = matchFiltro && matchSearch;
            r.style.display = show ? '' : 'none';
            if (show) vis++;
        });
        countEl.textContent = vis + ' registros';
    }

    document.getElementById('searchPais').addEventListener('input', aplicarFiltros);

    document.querySelectorAll('.filtro-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.filtro-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            filtroActual = btn.dataset.filtro;
            aplicarFiltros();
        });
    });
</script>
}