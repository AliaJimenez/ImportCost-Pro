@model ImportCostPro.Core.ViewModels.Pais.PaisFormViewModel

@{
    ViewData["Title"] = "Editar País";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-1">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <div class="icp-page-icon" style="background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.2);">
            <i class="bi bi-pencil-square" style="color: var(--accent-cyan);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Editar País</h1>
            <p class="icp-page-subtitle">Modifica los datos del país seleccionado</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="icp-card">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="icp-alert-danger mb-4"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="CodigoISO" class="icp-field-label">Código ISO</label>
                    <input asp-for="CodigoISO" class="form-control font-monospace" readonly />
                    <span asp-validation-for="CodigoISO" class="text-danger fs-xs"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Nombre" class="icp-field-label">Nombre del País</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger fs-xs"></span>
                </div>

                <div class="icp-toggle-panel mb-4">
                    <div class="icp-toggle-row">
                        <div>
                            <label asp-for="Activo" class="fw-600 fs-sm" style="color: var(--text-primary); cursor: pointer;">País Activo</label>
                            <small class="d-block mt-1" style="color: var(--text-muted);">Solo los países activos aparecen como opción en proveedores y productos.</small>
                        </div>
                        <input asp-for="Activo" class="form-check-input ms-3 fs-5" type="checkbox" role="switch" />
                    </div>
                </div>

                <div class="icp-form-footer">
                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn-save btn-save-cyan">
                        <i class="bi bi-pencil-square me-1"></i> Actualizar País
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}