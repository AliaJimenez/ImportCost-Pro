@model IEnumerable<ImportCostPro.Core.Dtos.OrdenProductoDto>

@{
    ViewData["Title"] = "Productos de la Orden";
    var ordenId = ViewBag.OrdenId as int? ?? 0;
    var numeroOrden = ViewBag.NumeroOrden as string ?? "";
    var estadoOrden = ViewBag.EstadoOrden as string ?? "";
    bool esAbierta = estadoOrden == "Abierta";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-controller="Orden" asp-action="Details" asp-route-id="@ordenId" class="btn-icp-view me-1">
            <i class="bi bi-arrow-left"></i> Volver a Orden
        </a>
        <div class="icp-page-icon" style="background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.2);">
            <i class="bi bi-tags" style="color: var(--accent-orange);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Productos de la Orden</h1>
            <p class="icp-page-subtitle">
                Orden: <strong style="color: var(--accent-cyan);">@numeroOrden</strong>
            </p>
        </div>
    </div>
    @if (esAbierta)
    {
        <a asp-action="Create" asp-route-ordenId="@ordenId" class="btn-icp-primary">
            <i class="bi bi-plus-lg"></i> Agregar Producto
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="icp-alert-success mb-4"><i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="icp-alert-danger mb-4"><i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]</div>
}

<div class="icp-table-wrapper">
    <div style="overflow-x: auto;">
        <table class="icp-table" style="min-width: 700px;">
            <thead>
                <tr>
                    <th style="width:30%;">Producto</th>
                    <th style="width:10%;" class="text-center">Cantidad</th>
                    <th style="width:14%;" class="text-end">FOB Unitario</th>
                    <th style="width:13%;" class="text-end">FOB Total</th>
                    <th style="width:10%;" class="text-end">Peso Total</th>
                    <th style="width:10%;" class="text-center">Margen %</th>
                    @if (esAbierta)
                    {
                        <th style="width:13%;" class="text-end">Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="@(esAbierta ? 7 : 6)" class="text-center py-5" style="color: var(--text-muted);">
                            <i class="bi bi-tags display-5 d-block mb-3" style="opacity:.25;"></i>
                            No hay productos en esta orden.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-600" style="color: var(--text-primary);">
                                <i class="bi bi-box-seam me-1" style="color: var(--accent-blue); font-size: 0.75rem;"></i>
                                @item.NombreProducto
                                <div style="font-size: 0.68rem; color: var(--text-muted);">@item.CodigoProducto</div>
                            </td>
                            <td class="text-center">@item.Cantidad.ToString("N0")</td>
                            <td class="text-end" style="color: var(--text-secondary);">@item.PrecioUnitarioFOB.ToString("N4")</td>
                            <td class="text-end fw-600" style="color: var(--accent-cyan);">@item.FOBTotal.ToString("N2")</td>
                            <td class="text-end" style="color: var(--text-secondary);">@item.PesoTotal.ToString("N3") kg</td>
                            <td class="text-center"><span class="icp-rate-blue">@item.MargenGananciaDeseado.ToString("N1")%</span></td>
                            @if (esAbierta)
                            {
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icp-edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icp-delete">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                    <tr style="background: rgba(6,182,212,0.04); border-top: 1px solid rgba(6,182,212,0.15);">
                        <td class="fw-700" style="color: var(--text-primary);" colspan="3">
                            <i class="bi bi-sigma me-1" style="color: var(--accent-cyan);"></i> TOTALES
                        </td>
                        <td class="text-end fw-700" style="color: var(--accent-cyan);">@Model.Sum(p => p.FOBTotal).ToString("N2")</td>
                        <td class="text-end fw-700" style="color: var(--text-secondary);">@Model.Sum(p => p.PesoTotal).ToString("N3") kg</td>
                        <td colspan="@(esAbierta ? 2 : 1)"></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
