@model IEnumerable<ImportCostPro.Core.Dtos.OrdenGastoDto>

@{
    ViewData["Title"] = "Gastos de Importación";
    var ordenId = ViewBag.OrdenId as int?;
    var numeroOrden = ViewBag.NumeroOrden as string ?? "";
    var estadoOrden = ViewBag.EstadoOrden as string ?? "";
    bool esAbierta = estadoOrden == "Abierta";
    var ordenes = ViewBag.Ordenes as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var filtroOrdenId = ViewBag.FiltroOrdenId as int?;
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        @if (ordenId.HasValue)
        {
            <a asp-controller="Orden" asp-action="Details" asp-route-id="@ordenId" class="btn-icp-view me-1">
                <i class="bi bi-arrow-left"></i> Volver a Orden
            </a>
        }
        <div class="icp-page-icon" style="background: rgba(139,92,246,0.12); border: 1px solid rgba(139,92,246,0.2);">
            <i class="bi bi-receipt-cutoff" style="color: var(--accent-purple);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Gastos de Importación</h1>
            <p class="icp-page-subtitle">
                @if (!string.IsNullOrEmpty(numeroOrden))
                {
                    <span>Orden: <strong style="color: var(--accent-cyan);">@numeroOrden</strong></span>
                }
                else
                {
                    <span>Todos los gastos registrados</span>
                }
            </p>
        </div>
    </div>
    @if (esAbierta && ordenId.HasValue)
    {
        <a asp-action="Create" asp-route-ordenId="@ordenId" class="btn-icp-primary"
        style="background: var(--accent-purple); box-shadow: 0 2px 8px rgba(139,92,246,0.25);">
            <i class="bi bi-plus-lg"></i> Registrar Gasto
        </a>
    }
    else if (!ordenId.HasValue)
    {
        @if (filtroOrdenId.HasValue)
        {
            <a asp-action="Create" asp-route-ordenId="@filtroOrdenId" class="btn-icp-primary"
            style="background: var(--accent-purple); box-shadow: 0 2px 8px rgba(139,92,246,0.25);">
                <i class="bi bi-plus-lg"></i> Registrar Gasto
            </a>
        }
        else
        {
            <span class="btn-icp-primary" style="opacity:0.5; cursor:not-allowed;"
            title="Selecciona una orden primero para registrar un gasto">
                <i class="bi bi-plus-lg"></i> Registrar Gasto
            </span>
        }
    }
</div>

<!-- Selector de orden si se accede desde el menú sin orden específica -->
@if (!ordenId.HasValue && ordenes != null)
{
    <div class="icp-card mb-4">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="filtroOrdenId" class="icp-field-label">Filtrar por Orden</label>
                    <select name="filtroOrdenId" id="filtroOrdenId" class="form-select">
                        <option value="">— Todas las órdenes —</option>
                        @foreach (var o in ordenes)
                        {
                            <option value="@o.Value">@o.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn-save w-100">
                        <i class="bi bi-funnel me-1"></i> Filtrar
                    </button>
                </div>
            </div>
        </form>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="icp-alert-success mb-4"><i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="icp-alert-danger mb-4"><i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]</div>
}

<div class="icp-table-wrapper">
    <table class="icp-table">
        <thead>
            <tr>
                @if (!ordenId.HasValue)
                {
                    <th style="width:15%;">N° Orden</th>
                }
                <th style="width:@(ordenId.HasValue ? "30%" : "22%");">Tipo de Gasto</th>
                <th style="width:15%;" class="text-end">Monto</th>
                <th style="width:12%;">Moneda</th>
                <th style="width:18%;">Distribución</th>
                <th style="width:10%;">Fecha</th>
                @if (esAbierta || !ordenId.HasValue)
                {
                    <th style="width:15%;" class="text-end">Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center py-5" style="color: var(--text-muted);">
                        <i class="bi bi-receipt display-5 d-block mb-3" style="opacity:.25;"></i>
                        No hay gastos registrados.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        @if (!ordenId.HasValue)
                        {
                            <td><span class="icp-code-badge">@item.NumeroOrden</span></td>
                        }
                        <td class="fw-600">
                            <i class="bi bi-tag-fill me-1" style="color: var(--accent-purple); font-size: 0.75rem;"></i>
                            @item.TipoGasto
                        </td>
                        <td class="text-end fw-600" style="color: var(--accent-orange);">
                            @item.SimboloMoneda @item.Monto.ToString("N2")
                        </td>
                        <td><span class="icp-code-badge">@item.NombreMoneda</span></td>
                        <td style="color: var(--text-secondary); font-size: 0.82rem;">@item.MetodoDistribucion</td>
                        <td style="color: var(--text-muted); font-size: 0.8rem;">@item.FechaGasto.ToString("dd/MM/yy")</td>
                        @if (item.OrdenPermiteModificaciones)
                        {
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icp-edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icp-delete">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        }
                        else if (esAbierta || !ordenId.HasValue)
                        {
                            <td></td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
