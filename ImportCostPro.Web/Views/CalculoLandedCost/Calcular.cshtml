@{
    ViewData["Title"] = "Calcular Landed Cost";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="mb-4"><i class="bi bi-calculator"></i> Calcular Landed Cost</h2>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>¡Atención!</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Calcular" method="post">
                        <div class="mb-4">
                            <label for="ordenImportacionId" class="form-label fw-bold">Seleccione la Orden (Solo Abiertas)</label>
                            <select class="form-select form-select-lg" id="ordenImportacionId" name="ordenImportacionId" asp-items="ViewBag.Ordenes" required>
                                <option value="">-- Seleccione una orden --</option>
                            </select>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                Generar Previsualización
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
