@model ImportCostPro.Core.ViewModels.Importador.ImportadorFormViewModel

@{
    ViewData["Title"] = "Eliminar Importador";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert alert-warning" role="alert">
                <h4 class="alert-heading">⚠️ Confirmar Eliminación</h4>
                <p>¿Está seguro que desea eliminar este importador?</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <p><strong>Nombre:</strong> @Model.Nombre</p>
                    <p><strong>RNC:</strong> @Model.Rnc</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Estado:</strong> @(Model.Activo ? "Activo" : "Inactivo")</p>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="mt-3">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Eliminar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>