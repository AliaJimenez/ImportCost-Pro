@model ImportCostPro.Core.ViewModels.Importador.ImportadorFormViewModel

@{
    ViewData["Title"] = "Editar Importador";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-1">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <div class="icp-page-icon" style="background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.2);">
            <i class="bi bi-pencil-square" style="color: var(--accent-cyan);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Editar Importador</h1>
            <p class="icp-page-subtitle">Actualiza la información legal del importador local</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="icp-card">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="icp-alert-danger mb-4"></div>

                <span class="icp-form-section-label">Datos Corporativos</span>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Nombre" class="icp-field-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="icp-field-label">RNC</label>
                        <input asp-for="Rnc" class="form-control font-monospace" readonly />
                    </div>
                </div>

                <span class="icp-form-section-label">Contacto</span>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Telefono" class="icp-field-label"></label>
                        <input asp-for="Telefono" class="form-control" />
                        <span asp-validation-for="Telefono" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="icp-field-label"></label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Contacto" class="icp-field-label"></label>
                    <input asp-for="Contacto" class="form-control" />
                    <span asp-validation-for="Contacto" class="text-danger fs-xs"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Direccion" class="icp-field-label"></label>
                    <textarea asp-for="Direccion" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Direccion" class="text-danger fs-xs"></span>
                </div>

                <div class="icp-toggle-panel mb-4">
                    <div class="icp-toggle-row">
                        <label asp-for="Activo" class="fw-600 fs-sm" style="color: var(--text-primary);">Estado Operativo</label>
                        <input asp-for="Activo" class="form-check-input ms-3 fs-5" type="checkbox" role="switch" />
                    </div>
                </div>

                <div class="icp-form-footer">
                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn-save btn-save-cyan">
                        <i class="bi bi-check-lg me-1"></i> Aplicar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}