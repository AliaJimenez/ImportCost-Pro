@* Views/Importador/Index.cshtml *@
@model IEnumerable<ImportCostPro.Core.ViewModels.Importador.ImportadorIndexViewModel>

@{
    ViewData["Title"] = "Importadores";
    Layout = "_Layout";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <div class="icp-page-icon" style="background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.2);">
            <i class="bi bi-person-badge" style="color: var(--accent-green);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Importadores</h1>
            <p class="icp-page-subtitle">Empresas importadoras registradas en el sistema</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-icp-primary">
        <i class="bi bi-plus-lg"></i> Crear Importador
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="icp-alert-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="icp-alert-danger mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
    </div>
}

<div class="icp-toolbar">
    <div class="icp-toolbar-left">
        <div class="icp-search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchImportador" placeholder="Buscar por nombre, RNC, email..." />
        </div>
        <div class="d-flex gap-1 ms-2">
            <button class="btn-icp-view filtro-btn active" data-filtro="todos">Todos</button>
            <button class="btn-icp-view filtro-btn" data-filtro="true">Activos</button>
            <button class="btn-icp-view filtro-btn" data-filtro="false">Inactivos</button>
        </div>
    </div>
    <div class="icp-toolbar-right">
        <span class="icp-count-label" id="countImportador">@Model.Count() registros</span>
    </div>
</div>

<div class="icp-table-wrapper">
    <table class="icp-table">
        <thead>
            <tr>
                <th style="width:12%;">RNC</th>
                <th style="width:25%;">Razón Social</th>
                <th style="width:15%;">Teléfono</th>
                <th style="width:13%;">País</th>
                <th style="width:25%;">Correo Electrónico</th>
                <th style="width:5%;">Estado</th>
                <th style="width:5%;" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody id="tbodyImportador">
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center py-5" style="color: var(--text-muted);">
                        <i class="bi bi-building display-5 d-block mb-3" style="opacity: .25;"></i>
                        No hay empresas importadoras registradas.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr class="imp-row" data-activo="@item.Activo.ToString().ToLower()">
                        <td><span class="icp-code-badge">@item.Rnc</span></td>
                        <td class="fw-600" style="color: var(--text-primary);">
                            <i class="bi bi-building me-2" style="color: var(--accent-green); font-size: 0.75rem;"></i>
                            @item.Nombre
                        </td>
                        <td style="color: var(--text-secondary);">
                            <i class="bi bi-telephone me-1" style="font-size: 0.72rem; opacity: 0.6;"></i>
                            @(string.IsNullOrEmpty(item.Telefono) ? "—" : item.Telefono)
                        </td>
                        <td class="fs-sm" style="color: var(--text-muted);">
                            <i class="bi bi-globe me-1" style="font-size: 0.72rem; opacity: 0.6;"></i>
                            @(string.IsNullOrEmpty(item.NombrePais) ? "—" : item.NombrePais)
                        </td>
                        <td class="fs-sm" style="color: var(--text-muted);">
                            <i class="bi bi-envelope me-1" style="font-size: 0.72rem; opacity: 0.6;"></i>
                            @(string.IsNullOrEmpty(item.Email) ? "—" : item.Email)
                        </td>
                        <td>
                            @if (item.Activo)
                            {
                                <span class="icp-badge icp-badge-success">
                                    <i class="bi bi-check-circle-fill" style="font-size:0.55rem;"></i> Activo
                                </span>
                            }
                            else
                            {
                                <span class="icp-badge icp-badge-cerrada">
                                    <i class="bi bi-x-circle-fill" style="font-size:0.55rem;"></i> Inactivo
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icp-edit">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icp-delete">
                                    <i class="bi bi-trash3"></i> Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    const rows = document.querySelectorAll('.imp-row');
    const countEl = document.getElementById('countImportador');
    let filtroActual = 'todos';

    function aplicarFiltros() {
        const q = document.getElementById('searchImportador').value.toLowerCase();
        let vis = 0;
        rows.forEach(function (r) {
            const activo = r.dataset.activo;
            const matchFiltro = filtroActual === 'todos' || activo === filtroActual;
            const matchSearch = r.textContent.toLowerCase().includes(q);
            const show = matchFiltro && matchSearch;
            r.style.display = show ? '' : 'none';
            if (show) vis++;
        });
        countEl.textContent = vis + ' registros';
    }

    document.getElementById('searchImportador').addEventListener('input', aplicarFiltros);
    document.querySelectorAll('.filtro-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.filtro-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            filtroActual = btn.dataset.filtro;
            aplicarFiltros();
        });
    });
</script>
}