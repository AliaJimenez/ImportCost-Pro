@model ImportCostPro.Core.ViewModels.Importador.ImportadorFormViewModel

@{
    ViewData["Title"] = "Registrar Importador";
}

<div class="icp-page-header">
    <div class="icp-page-header-left">
        <a asp-action="Index" class="btn-icp-view me-1">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
        <div class="icp-page-icon" style="background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.2);">
            <i class="bi bi-person-badge" style="color: var(--accent-green);"></i>
        </div>
        <div>
            <h1 class="icp-page-title">Registrar Importador</h1>
            <p class="icp-page-subtitle">Define el perfil fiscal corporativo</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="icp-card">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="icp-alert-danger mb-4"></div>

                <span class="icp-form-section-label">Datos Corporativos</span>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Nombre" class="icp-field-label"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Importaciones Dominicana SAS" />
                        <span asp-validation-for="Nombre" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Rnc" class="icp-field-label">RNC</label>
                        <input asp-for="Rnc" class="form-control font-monospace" placeholder="131-XXXXX-X" />
                        <span asp-validation-for="Rnc" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Pais" class="icp-field-label">País</label>
                    <select asp-for="Pais" asp-items="Model.Paises" class="form-select">
                        <option value="">-- Seleccione un País --</option>
                    </select>
                    <span asp-validation-for="Pais" class="text-danger fs-xs"></span>
                </div>
                <span class="icp-form-section-label">Contacto</span>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Telefono" class="icp-field-label"></label>
                        <input asp-for="Telefono" class="form-control" placeholder="809-555-0199" />
                        <span asp-validation-for="Telefono" class="text-danger fs-xs"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="icp-field-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="finanzas@empresa.com" type="email" />
                        <span asp-validation-for="Email" class="text-danger fs-xs"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Contacto" class="icp-field-label"></label>
                    <input asp-for="Contacto" class="form-control" placeholder="Nombre de la persona encargada" />
                    <span asp-validation-for="Contacto" class="text-danger fs-xs"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Direccion" class="icp-field-label"></label>
                    <textarea asp-for="Direccion" class="form-control" rows="2" placeholder="Dirección física legal..."></textarea>
                    <span asp-validation-for="Direccion" class="text-danger fs-xs"></span>
                </div>

                <div class="icp-toggle-panel mb-4">
                    <div class="icp-toggle-row">
                        <div>
                            <label asp-for="Activo" class="fw-600 fs-sm" style="color: var(--text-primary); cursor: pointer;">Importador Activo</label>
                            <small class="d-block mt-1" style="color: var(--text-muted);">Solo los importadores activos pueden ser asignados a nuevas órdenes de importación.</small>
                        </div>
                        <input asp-for="Activo" class="form-check-input ms-3 fs-5" type="checkbox" role="switch" checked />
                    </div>
                </div>

                <div class="icp-form-footer">
                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn-save">
                        <i class="bi bi-check-lg me-1"></i> Guardar Importador
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}